#ifndef __MS_TIMER_H__
#define __MS_TIMER_H__
/* Includes ---------------------------------------------------------------------------------------*/
#include <ms_main.h>

/* Exported define ---------------------------------------------------------------------------------*/
/* Exported macro ----------------------------------------------------------------------------------*/
#define SW_TIMER_MAX        7
#define TIMx_PRESCALER_1MS  6-1
#define TIMx_PERIOD_1MS     6000                                                              /*jkpark2 2007-12-13 타이머의 ch별로는 Peroid를 변경할 수 없다.*/
/* Exported typedef --------------------------------------------------------------------------------*/
    
typedef struct{
    char                timerEnable;
    long                setCount;
    long                counter;
    int                 (*func)(void);
}SWTimerStructType;

typedef struct{
    int                 elementCount;
    SWTimerStructType   timerList[SW_TIMER_MAX];    
}SWTimerListType;

#define     __1mS           1                                    //jkpark 2025-12-05 Timer를 1mS보다 빠른 타이머에 배치할 경우 그에 맞게 조절.

/* Exported macro ------------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
void TimerProcess( void );
msStatus_t TimerAdd( long interval, int (*func)(void), int *pElementID);
msStatus_t TimerRestart(int elementID);
msStatus_t TimerDelete(int elementID);

/* Exported variables ------------------------------------------------------------------------------*/
/* Exported function prototypes --------------------------------------------------------------------*/
u32 DWT_Delay_Init(void);


__STATIC_INLINE void Delay_us(__IO uint32_t microseconds) {	// delay_us
  u32 clk_cycle_start = DWT->CYCCNT;

  microseconds *= (HAL_RCC_GetHCLKFreq() / 1000000U);			// Go to number of cycles for system
  while ((DWT->CYCCNT - clk_cycle_start) < microseconds);		// Delay till end
}

#endif //__MS_TIMER_H__
