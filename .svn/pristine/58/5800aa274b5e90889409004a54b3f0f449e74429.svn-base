#ifndef __MS_MVB_H__
#define __MS_MVB_H__
/* Includes ---------------------------------------------------------------------------------------*/
#include <ms_main.h>

/* Exported define ---------------------------------------------------------------------------------*/
#define MVB_RX_MAX    			512
#define CMD_CHK_REDY			0x11
#define CMD_SET_CYCL			0x21
#define CMD_SET_PORT			0x31
#define CMD_TX_MKDAT			0x61

/* Exported macro ----------------------------------------------------------------------------------*/
/* Exported typedef --------------------------------------------------------------------------------*/
typedef enum {                                                                          //KKD 2025-11-26 수신 방식
    MVB_MODE_POLLING = 0,
    MVB_MODE_INTERRUPT
} eMvbRxMode;

typedef struct {
    u8 u8RxDmaBuf[MVB_RX_MAX];
    u8 u8RxDataFrameBuf[MVB_RX_MAX];
    volatile BOOL bRxOk;
    u16 u16PrevPos;
    eMvbRxMode eRxMode;
} sMvbData;

/* Exported variables ------------------------------------------------------------------------------*/
extern sMvbData g_sMvbData;

/* Exported function prototypes --------------------------------------------------------------------*/
void MVB_Init(eMvbRxMode mode);
void MVB_Receive_DMA_Poll(void);
void MVB_RxData_FrameParser(u8 byte);
void MVB_ProcessFrame(u8 *buf);
void MVB_HandleCommand(u8 cmd, u8 *data, u8 len);
void MVB_SendFrame(u8 cmd, u8 *data, u8 len);

u8 MVB_InitSequence(void);





#endif //__MS_MVB_H__
