#ifndef EEP_M24256A_H
#define EEP_M24256A_H

#include <ms_main.h>

#define SLA24EEP	((u8)0xA0)							/* M24256A Slave Address */
#define PAGEWRT		((u16)0x0040)						// M24256A Page Write

////////////////////////////////////////////////

//#define ENORSTR	((u16)0x0000)						// Log Data save data (0x0000 ~ 0x5FFF) 64byte, 384EA
#define EERRSTR		((u16)0x6000)						// Alarm Information save data (0x6000 ~ 0x7D00) 64byte, 116EA
#define EERREND		((u16)0x7D00)
#define ECALMST		(EERREND)							// Master Calibration data 256 byte
#define ECALSLV		((u16)0x7E00)						// Slave Calibration data 256 byte
#define ESYSSTR		((u16)0x7F00)						// system data 256 byte

//#define ECNTNOR		((EERRSTR-ENORSTR)/PAGEWRT)
#define ECNTNOR		((EERRSTR)/PAGEWRT)
#define ECNTERR		((EERREND-EERRSTR)/PAGEWRT)

////////////////////////////////////////////////

#define MRATPI		(ECALMST)							 // Calibration data 256 byte
#define MGABPI		(MRATPI	+ (4U*sizeof(float_t)))
#define MRATPV		(MGABPI	+ (4U*sizeof(float_t)))
#define MGABPV		(MRATPV	+ (4U*sizeof(float_t)))
#define MRATAX		(MGABPV	+ (4U*sizeof(float_t)))
#define MGABAX		(MRATAX	+ (1U*sizeof(float_t)))

////////////////////////////////////////////////

#define MFDATA		(ESYSSTR)							// System data 256 byte
#define MSRNUM		(MFDATA + (3U*sizeof(u8)))
#define HIPADD		(MSRNUM + (4U*sizeof(u8)))
#define MSBONT		(HIPADD + (25U*sizeof(u16)))		// Cell Balancing On Time

#pragma pack(push,1)
typedef struct {
	u8	rtc[7];											// 7		Local Time(RTC)
	u8	flag[8];										// 2 15
	u16	pv;												// 2 17		10[mV]
	s16	pi;												// 2 19		100[mA]
	u16	aux;											// 2 21
	u16	avgcv;											// 2 23 	Avg Cell Volt
	u16	maxcv;											// 2 25 	Max Cell Volt
	u8	maxcvn;											// 1 26 	Max Cell Volt Number
	u16	mincv;											// 2 28 	Min Cell Volt
	u8	mincvn;											// 1 29 	Min Cell Volt Number
	s16	avgth;											// 2 31
	s16	maxth;											// 2 33
	u8	maxthn;											// 1 34
	s16	minth;											// 2 36
	u8	minthn;											// 1 37
	u16	soc;											// 2 39
	u32	cap;											// 4 43
	u32	fcap;											// 4 47
	u16	ccnt;											// 2 49
	u16	errcnt;											// 2 51
	u32	bmsontime;										// 4 55
	u8		crc;										// 1 56
} Pkt_EEP ;						// 56+50


void SaveBmsData(void);
void EEPDataRead(u8 mode, u16 rxcnt, u8 *eepdata);
void EEPDataClear(u8 mode);
void EEPSaveData(void);
void Eep_ReadSysInfo(void);
void Eep_WriteBalontime_init(void);
void Eep_Writebalontime(void);
void Eep_Readbalontime(void);
void Eep_WriteHostIpAddr(void);
u8 Eep_ReadHostIpAddr(void);

#endif

