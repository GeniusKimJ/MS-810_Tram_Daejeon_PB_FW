/* Includes ---------------------------------------------------------------------------------------*/
#include <ms_adc.h>

/* Private define ---------------------------------------------------------------------------------*/
#define ADC_REF_MV        	(3300.0f)
#define ADC_15BIT_MAX     	(32767.0f)

#define ADC_LSB_15BIT_MV  	(ADC_REF_MV / ADC_15BIT_MAX)

#define AUX33_GAIN        	(0.3197279f)
#define CONST_AUX33_15BIT 	(ADC_LSB_15BIT_MV / AUX33_GAIN)	// [mV / count]

#define AUX5_GAIN         	(0.3197279f)
#define CONST_AUX5_15BIT  	(ADC_LSB_15BIT_MV / AUX5_GAIN)	// [mV / count]

#define AUX13_GAIN        	(0.153f)
#define CONST_AUX13_15BIT 	(ADC_LSB_15BIT_MV / AUX13_GAIN)	// [mV / count]

#define AUX24_GAIN        	(0.0874786f)
#define CONST_AUX24_15BIT 	(ADC_LSB_15BIT_MV / AUX24_GAIN)	// [mV / count]

/* Private macro ----------------------------------------------------------------------------------*/
/* Private typedef --------------------------------------------------------------------------------*/
/* Private variables ------------------------------------------------------------------------------*/
#define ADC1_CH_NUM     4
#define ADC2_CH_NUM     3
#define ADC3_CH_NUM     2

#define ADC_AVG_COUNT   8
#define ADC_BUF_SIZE    ((8 * ADC_AVG_COUNT) + 1 )                                                               //jkpark 2026-01-05 8개를 누적하기 위해 9개의 버퍼가 필요함.

u16 g_u16Adc1[ ADC1_CH_NUM ] = {0,};                                                    //jkpark 2026-01-16 12Bit이므로 u16으로 설정해야함.
u16 g_u16Adc2[ ADC2_CH_NUM ] = {0,};                                                    //jkpark 2026-01-16 12Bit이므로 u16으로 설정해야함.
u16 g_u16Adc3[ ADC3_CH_NUM ] = {0,};                                                    //jkpark 2026-01-16 12Bit이므로 u16으로 설정해야함.

u32 g_u32Adc1_Buf[ ADC1_CH_NUM ][ ADC_BUF_SIZE ] = {0,};
u32 g_u32Adc2_Buf[ ADC2_CH_NUM ][ ADC_BUF_SIZE ] = {0,};
u32 g_u32Adc3_Buf[ ADC3_CH_NUM ][ ADC_BUF_SIZE ] = {0,};
u32 g_u32Adc1_index;
u32 g_u32Adc2_index;
u32 g_u32Adc3_index;

u32 g_u32AdcSum[ ID_ADC__NUM_MAX ] = {0,};

//float v13_mV  = ad15 * CONST_AUX13_15BIT;
//float v24_mV  = ad15 * CONST_AUX24_15BIT;
//float v5_mV   = ad15 * CONST_AUX5_15BIT;
//float v33_mV  = ad15 * CONST_AUX33_15BIT;


/* Private function prototypes --------------------------------------------------------------------*/
/* Private functions ------------------------------------------------------------------------------*/

void ADC_InitAll( void )
{
    HAL_ADC_Start_DMA( &hadc1, (uint32_t*)g_u16Adc1, ADC1_CH_NUM);
    HAL_ADC_Start_DMA( &hadc2, (uint32_t*)g_u16Adc2, ADC2_CH_NUM);
    HAL_ADC_Start_DMA( &hadc3, (uint32_t*)g_u16Adc3, ADC3_CH_NUM);
}

s32 ADC_GetStmAdc15bit( AdcIDType adcID )
{
    uint32_t VDD_mV;
    if( g_u32AdcSum[ ID_ADC1_VREFINT ] != 0 )
    {
    VDD_mV = (u32)VREFINT_CAL_VREF
           * (u32)(*VREFINT_CAL_ADDR)
			   / (u32)( ( g_u32AdcSum[ ID_ADC1_VREFINT ] / ADC_AVG_COUNT ) >> 3 );
    }else
    {
    	VDD_mV = VREFINT_CAL_VREF;
    }
    return ( g_u32AdcSum[ adcID ] / ADC_AVG_COUNT ) * VDD_mV / VREFINT_CAL_VREF;
}
