void Can_Fifo_In(CAN_TxHeaderTypeDef* pTxHeader, u8 u8CanData[], Enum_McuCan_Type eMcuCan)
{
#ifdef CAN_BUF_UPATE    																//2025-11-27   jkpark  Can Buffer 관련 수정.
    sCanData canTemp;
    int retValue = 0;
//    int usedSize = 0;

    memcpy( &canTemp.TxHeader , pTxHeader , sizeof( CAN_TxHeaderTypeDef ) );
    memcpy( canTemp.u8Data    , u8CanData , CAN_DATA_SIZE                 );

    retValue = BufferWrite( &g_stFifo[eMcuCan].bufInfo, (unsigned char*)&canTemp, sizeof( sCanData ), NULL );

    if( retValue == FALSE ){
        g_stFifo[eMcuCan].u32RemainZeroCount ++;
    }

#else  //CAN_BUF_UPATE
	u8 i = 0;

	// Data Input
	g_stFifo[eMcuCan].stCanData[g_stFifo[eMcuCan].u32InputPos].TxHeader.StdId = pTxHeader->StdId;
	g_stFifo[eMcuCan].stCanData[g_stFifo[eMcuCan].u32InputPos].TxHeader.ExtId = pTxHeader->ExtId;
	g_stFifo[eMcuCan].stCanData[g_stFifo[eMcuCan].u32InputPos].TxHeader.IDE = pTxHeader->IDE;
	g_stFifo[eMcuCan].stCanData[g_stFifo[eMcuCan].u32InputPos].TxHeader.RTR = pTxHeader->RTR;
	g_stFifo[eMcuCan].stCanData[g_stFifo[eMcuCan].u32InputPos].TxHeader.DLC = pTxHeader->DLC;
	g_stFifo[eMcuCan].stCanData[g_stFifo[eMcuCan].u32InputPos].TxHeader.TransmitGlobalTime = pTxHeader->TransmitGlobalTime;

	for(i = 0; i < 8; i ++){
		g_stFifo[eMcuCan].stCanData[g_stFifo[eMcuCan].u32InputPos].u8Data[i] = u8CanData[i];
	}

	// Input Count ++
	g_stFifo[eMcuCan].u32InputPos ++;
	if(g_stFifo[eMcuCan].u32InputPos >= FIFO_CAN_MAX)
		g_stFifo[eMcuCan].u32InputPos = 0;

	// Calcul Remain
	if(g_stFifo[eMcuCan].u32InputPos < g_stFifo[eMcuCan].u32OutPos){                    //KKD 2025-12-01 compare in out pos
		g_stFifo[eMcuCan].u32Remain = FIFO_CAN_MAX - g_stFifo[eMcuCan].u32OutPos + g_stFifo[eMcuCan].u32InputPos;
	}else{
		g_stFifo[eMcuCan].u32Remain = g_stFifo[eMcuCan].u32InputPos - g_stFifo[eMcuCan].u32OutPos;
	}
	
	if(g_stFifo[eMcuCan].u32MaxRemain < g_stFifo[eMcuCan].u32Remain){                   //KKD 2025-12-01 max pos = curr pos 대치
		g_stFifo[eMcuCan].u32MaxRemain = g_stFifo[eMcuCan].u32Remain;
	}
#endif //CAN_BUF_UPATE

}

u32 Can_Fifo_GetRemainCount(Enum_McuCan_Type eMcuCan)
{
#ifdef CAN_BUF_UPATE    																//2025-11-27   jkpark  Can Buffer 관련 수정.
    return ( g_stFifo[eMcuCan].bufInfo.bufSize - g_stFifo[eMcuCan].bufInfo.index );
#else  //CAN_BUF_UPATE
	if(g_stFifo[eMcuCan].u32Remain == 0)
		g_stFifo[eMcuCan].u32RemainZeroCount ++;

	return g_stFifo[eMcuCan].u32Remain;
#endif //CAN_BUF_UPATE
}

u32 Can_Fifo_GetMaxRemainCount(Enum_McuCan_Type eMcuCan)
{
#ifdef CAN_BUF_UPATE    //2025-11-27   jkpark  Can Buffer 관련 수정.
	return g_stFifo[eMcuCan].bufInfo.bufSize;
#else  //CAN_BUF_UPATE
	return g_stFifo[eMcuCan].u32MaxRemain;                                              //KKD 2025-12-01 최대 fifo
#endif //CAN_BUF_UPATE
}

u32 Can_Fifo_GetRemainZeroCount(Enum_McuCan_Type eMcuCan)
{
	return g_stFifo[eMcuCan].u32RemainZeroCount;
}

BOOL Can_Fifo_Out(CAN_TxHeaderTypeDef* pTxHeader, u8 u8CanData[], Enum_McuCan_Type eMcuCan)
{
#ifdef CAN_BUF_UPATE    																//2025-11-27   jkpark  Can Buffer 관련 수정.
    sCanData canTemp;
    
	if( BufferRead( &g_stFifo[eMcuCan].bufInfo, (unsigned char*)&canTemp, sizeof( sCanData ), NULL ) == FALSE ){
		return FALSE;
	}

	// Data Input
    memcpy( pTxHeader , &canTemp.TxHeader , sizeof( CAN_TxHeaderTypeDef ) );
    memcpy( u8CanData , canTemp.u8Data    , CAN_DATA_SIZE                 );

	return TRUE;
#else  //CAN_BUF_UPATE
	u8 i = 0;
	
	if(g_stFifo[eMcuCan].u32Remain == 0){
		return FALSE;
	}
	
	// Data Input
	pTxHeader->StdId = g_stFifo[eMcuCan].stCanData[g_stFifo[eMcuCan].u32OutPos].TxHeader.StdId;
	pTxHeader->ExtId = g_stFifo[eMcuCan].stCanData[g_stFifo[eMcuCan].u32OutPos].TxHeader.ExtId;
	pTxHeader->IDE = g_stFifo[eMcuCan].stCanData[g_stFifo[eMcuCan].u32OutPos].TxHeader.IDE;
	pTxHeader->RTR = g_stFifo[eMcuCan].stCanData[g_stFifo[eMcuCan].u32OutPos].TxHeader.RTR;
	pTxHeader->DLC = g_stFifo[eMcuCan].stCanData[g_stFifo[eMcuCan].u32OutPos].TxHeader.DLC;
	pTxHeader->TransmitGlobalTime = g_stFifo[eMcuCan].stCanData[g_stFifo[eMcuCan].u32OutPos].TxHeader.TransmitGlobalTime;

	for(i = 0; i < 8; i ++){
		u8CanData[i] = g_stFifo[eMcuCan].stCanData[g_stFifo[eMcuCan].u32OutPos].u8Data[i];
	}
	
	// Input Count ++
	g_stFifo[eMcuCan].u32OutPos ++;
	if(g_stFifo[eMcuCan].u32OutPos >= FIFO_CAN_MAX){
		g_stFifo[eMcuCan].u32OutPos = 0;
	}

	// Calcul Remain
	if(g_stFifo[eMcuCan].u32InputPos < g_stFifo[eMcuCan].u32OutPos){
		g_stFifo[eMcuCan].u32Remain = FIFO_CAN_MAX - g_stFifo[eMcuCan].u32OutPos + g_stFifo[eMcuCan].u32InputPos;
	}else{
		g_stFifo[eMcuCan].u32Remain = g_stFifo[eMcuCan].u32InputPos - g_stFifo[eMcuCan].u32OutPos;
	}
	
	if(g_stFifo[eMcuCan].u32MaxRemain < g_stFifo[eMcuCan].u32Remain){
		g_stFifo[eMcuCan].u32MaxRemain = g_stFifo[eMcuCan].u32Remain;
	}
	
	return TRUE;
#endif //CAN_BUF_UPATE
}

void Can_Fifo_TxCheck_In(CAN_TxHeaderTypeDef* pTxHeader, u8 u8CanData[], Enum_McuCan_Type eMcuCan)
{
	u8 i = 0;
	
	g_stLastTxCanData[eMcuCan].TxHeader.StdId = pTxHeader->StdId;
	g_stLastTxCanData[eMcuCan].TxHeader.ExtId= pTxHeader->ExtId;
	g_stLastTxCanData[eMcuCan].TxHeader.IDE = pTxHeader->IDE;
	g_stLastTxCanData[eMcuCan].TxHeader.RTR= pTxHeader->RTR;
	g_stLastTxCanData[eMcuCan].TxHeader.DLC = pTxHeader->DLC;
	g_stLastTxCanData[eMcuCan].TxHeader.TransmitGlobalTime = pTxHeader->TransmitGlobalTime;

	for(i = 0; i < 8; i ++){
		g_stLastTxCanData[eMcuCan].u8Data[i] = u8CanData[i];
	}
	g_stFifo[eMcuCan].bTxDone = FALSE;
}

void Can_Fifo_TxCheck_SetTxDone(Enum_McuCan_Type eMcuCan)
{
	g_stFifo[eMcuCan].bTxDone = TRUE;
	g_stFifo[eMcuCan].u8CanTxOkFalseCount = 0;

#ifdef CAN_BUF_UPATE    																//2025-11-27   jkpark  Can Buffer 관련 수정.
    BufferInit( &g_stFifo[eMcuCan].bufInfo, (unsigned char*)g_stFifo[eMcuCan].stCanData , sizeof( g_stFifo[eMcuCan].stCanData ));
#endif //CAN_BUF_UPATE
}

BOOL Can_Fifo_TxCheck_TxOkFalseCount(Enum_McuCan_Type eMcuCan)
{
	if(g_stFifo[eMcuCan].u8CanTxOkFalseCount < 30){
		g_stFifo[eMcuCan].u8CanTxOkFalseCount ++;
		return FALSE;
	}else{
		return TRUE;
	}
}

BOOL Can_Fifo_TxCheck_GetTxDone(Enum_McuCan_Type eMcuCan)
{
	return g_stFifo[eMcuCan].bTxDone;                                                   //KKD 2025-11-26 TX 확인
}

void Can_Fifo_TxCheck_SetTxReady(Enum_McuCan_Type eMcuCan)
{
	g_stFifo[eMcuCan].bTxDone = FALSE;                                                  //KKD 2025-11-26 TX 상태 설정
}


BOOL Can_Fifo_TxCheck_GetLastTx(sCanData* pstLastData, Enum_McuCan_Type eMcuCan)
{
	u8 i = 0;

	if(g_stLastTxCanData[eMcuCan].TxHeader.DLC == 0){
		return FALSE;
	}
	pstLastData->TxHeader.StdId = g_stLastTxCanData[eMcuCan].TxHeader.StdId;            //KKD 2025-11-26 마지막 송신값 Check
	pstLastData->TxHeader.ExtId = g_stLastTxCanData[eMcuCan].TxHeader.ExtId;
	pstLastData->TxHeader.IDE = g_stLastTxCanData[eMcuCan].TxHeader.IDE;
	pstLastData->TxHeader.RTR = g_stLastTxCanData[eMcuCan].TxHeader.RTR;
	pstLastData->TxHeader.DLC = g_stLastTxCanData[eMcuCan].TxHeader.DLC;
	pstLastData->TxHeader.TransmitGlobalTime = g_stLastTxCanData[eMcuCan].TxHeader.TransmitGlobalTime;

	for(i = 0; i< 8; i ++){
		pstLastData->u8Data[i] = g_stLastTxCanData[eMcuCan].u8Data[i];
	}
	return TRUE;
}

