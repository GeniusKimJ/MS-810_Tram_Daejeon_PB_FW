/* Includes ---------------------------------------------------------------------------------------*/
#include <ms_spi.h>

/* Private define ---------------------------------------------------------------------------------*/
/* Private macro ----------------------------------------------------------------------------------*/
/* Private typedef --------------------------------------------------------------------------------*/
/* Private variables ------------------------------------------------------------------------------*/
/* Private function prototypes --------------------------------------------------------------------*/
/* Private functions ------------------------------------------------------------------------------*/


void HAL_SPI_TxRxCpltCallback(SPI_HandleTypeDef *hspi)
{
	if(hspi->Instance == SPI1){
		if(g_sAd6815Data.eAdCvRead[0] == AdReadProc_StartDma_Type){
			g_sAd6815Data.eAdCvRead[0] = AdReadProc_Read_Type;
		}else if(g_sAd6815Data.eAdThRead[0] == AdReadProc_StartDma_Type){
			g_sAd6815Data.eAdThRead[0] = AdReadProc_Read_Type;
		}
	}else if(hspi->Instance == SPI2){
		if(g_sAd6815Data.eAdCvRead[1] == AdReadProc_StartDma_Type){
			g_sAd6815Data.eAdCvRead[1] = AdReadProc_Read_Type;
		}else if(g_sAd6815Data.eAdThRead[1] == AdReadProc_StartDma_Type){
			g_sAd6815Data.eAdThRead[1] = AdReadProc_Read_Type;
		}

	}
}

