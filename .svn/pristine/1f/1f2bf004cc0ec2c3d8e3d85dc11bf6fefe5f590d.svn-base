/* Private function prototypes --------------------------------------------------------------------*/
/* Private functions ------------------------------------------------------------------------------*/
u8 Bcd2Dec(u8 val){
    return (u8)((val >> 4) * 10 + (val & 0x0F));
}

u8 Dec2Bcd(u8 val){
    return (u8)(((val / 10) << 4) | (val % 10));
}

void RTC_SetLocalTime(u8 *rtc){
    u8 year, month, date, weekday, hour, minute, sec;
    u8 error_flag = 0U;

    sec     = rtc[0];
    minute  = rtc[1];
    hour    = rtc[2];
    weekday	= rtc[3];
    date    = rtc[4];
    month   = rtc[5];
    year    = rtc[6];

    /* Range Check */
    if((month	 == 0U) || (month > 12U)) {error_flag = 1U;}
    if((date  	== 0U) || (date  > 31U)) {error_flag = 1U;}
    if((weekday	== 0U) || (weekday > 7U)) {error_flag = 1U;}
    if(hour   	>= 24U) {error_flag = 1U;}
    if(minute	>= 60U) {error_flag = 1U;}
    if(sec    	>= 60U) {error_flag = 1U;}

    if(error_flag == 0U) {
        memset((void*)MCP7940_RTC, 0x00, sizeof(MCP7940_RTC));
        HAL_I2C_Mem_Write(&hi2c1, SLVMCP7940, 0x00, I2C_MEMADD_SIZE_8BIT, MCP7940_RTC, MCP7940_RTCDATA_LEN, 20);
        MCP7940_RTC[0] = (((sec     / 10U) << 4U) | (sec % 10U)) | RTC_ST_FLAG;   
        MCP7940_RTC[1] = (((minute / 10U) << 4U) | (minute % 10U));
        MCP7940_RTC[2] = (((hour    / 10U) << 4U) | (hour % 10U));
        MCP7940_RTC[3] = weekday;
        MCP7940_RTC[4] = (((date / 10U) << 4U) | (date % 10U));
        MCP7940_RTC[5] = (((month / 10U) << 4U) | (month % 10U));
        MCP7940_RTC[6] = (((year / 10U) << 4U) | (year % 10U));
        HAL_I2C_Mem_Write(&hi2c1, SLVMCP7940, 0x00, I2C_MEMADD_SIZE_8BIT,MCP7940_RTC, MCP7940_RTCDATA_LEN, 20);

//        MCP7940_RTC[0] = (((sec/10U)<<4U) | (sec%10U)) | 0x80 ;	 // ST 유지
//        HAL_I2C_Mem_Write(&hi2c1, SLVMCP7940, 0x00, I2C_MEMADD_SIZE_8BIT, &MCP7940_RTC[0] , 1U, 20);
    }
}


void RTC_GetLocalTime(u8 *rtc)
{
	static u16 sseccnt = 0;
	if(++sseccnt>=10){
		sseccnt = 0;
		if (HAL_I2C_Mem_Read(&hi2c1, SLVMCP7940, 0x00U, I2C_MEMADD_SIZE_8BIT,
	                         MCP7940_RTC, MCP7940_RTCDATA_LEN, 20) == HAL_OK){
	        fCheckRtc = 0U;
	    } else {
	        fCheckRtc = 1U;
	    }

	    rtc[0] = Bcd2Dec(MCP7940_RTC[0] & 0x7F);
	    rtc[1] = Bcd2Dec(MCP7940_RTC[1]);
	    rtc[2] = Bcd2Dec(MCP7940_RTC[2]);
	    rtc[3] = (u8)(MCP7940_RTC[3] & 0x07U);  		 // weekday
	    rtc[4] = Bcd2Dec(MCP7940_RTC[4]);
	    rtc[5] = Bcd2Dec(MCP7940_RTC[5]);
	    rtc[6] = Bcd2Dec(MCP7940_RTC[6]);

	}
}	


void RTC_GetSocToMcp7940(void){
    static u8 CntStep = 0;
    u8 k, crc;
    u8 *str;
    static s32 datetime;

    switch(CntStep){
        case 0:
            HAL_I2C_Mem_Read(&hi2c1, 
            					SLVMCP7940, MCP7940_SRAM_ADDR,
                             	I2C_MEMADD_SIZE_8BIT, 
                             	(void *)&RamPkt,
                             	sizeof(sMCP7940_Ram), 
                             	50U);

            str = (void *)&RamPkt;
            crc = 0x41;
            for(k = 0; k < (sizeof(sMCP7940_Ram)-1U); k++){
                crc = TwiCRC[crc ^ str[k]];
			}
			
            if(RamPkt.crc == crc) {
            	CntStep = 2;
            }else{
            	CntStep = 1;
            }break;

        case 1:
            HAL_I2C_Mem_Read(&hi2c1, 
            					SLVMCP7940,
                             	MCP7940_SRAM_ADDR + sizeof(sMCP7940_Ram),
                             	I2C_MEMADD_SIZE_8BIT, 
                             	(void *)&RamPkt,
                             	sizeof(sMCP7940_Ram), 
                             	20U);

            str = (void *)&RamPkt;
            crc = 0x41;
            for(k = 0; k < (sizeof(sMCP7940_Ram)-1U); k++){
                crc = TwiCRC[crc ^ str[k]];
			}
            if(RamPkt.crc == crc) {
            	CntStep = 2;
            }else{
            	CntStep = 3;
            }break;

        case 2:
            RackPkt.bmsontime  = RamPkt.bmsontime;
            RackPkt.datacap    = RamPkt.cap;
            RackPkt.cyclecap   = RamPkt.cyclecap;
            RackPkt.cyccnt     = RamPkt.cyccnt;
            RackPkt.errcnt     = RamPkt.errcnt;
            RackPkt.norcnt     = RamPkt.norcnt;
            RackPkt.tot_dch_pw	= RamPkt.tot_dch_pw;

            RTC_GetLocalTime(RackPkt.rtc);
            datetime = (12L * RackPkt.rtc[6]) + RackPkt.rtc[5];
            datetime = (31L * datetime) + RackPkt.rtc[4];
            datetime = (24L * datetime) + RackPkt.rtc[2];
            datetime = (60L * datetime) + RackPkt.rtc[1];
            datetime = (60L * datetime) + RackPkt.rtc[0];
            datetime = datetime - RamPkt.time;

            if(datetime >= CONSTCNTVSOC){
                datetime = CONSTCNTVSOC;
            }

            RackPkt.dlyvsoc = (u16)datetime;
            CntStep = 4;
            break;

        case 3:
            RackPkt.bmsontime  = 0;
            RackPkt.datacap    = (u32)CONSTFULLCAP/100UL*50UL;
            RackPkt.cyclecap   = (u32)CONSTFULLCAP/100UL*50UL;
            RackPkt.cyccnt     = 0;
            RackPkt.errcnt     = 0;
            RackPkt.norcnt     = 0;
            RackPkt.dlyvsoc    = CONSTCNTVSOC;
            RackPkt.tot_dch_pw = 0;
            CntStep = 4;
            break;

        default:
            break;
    }
}


void RTC_SaveSocToMcp7940(u8 *rtc)
{
    static u8 Cnt1sec = 0U;
    static u32 datetime;
    u8 k, crc;
    u8 *str;

    if(++Cnt1sec > 10U) {
    	Cnt1sec = 1U;
    }

    switch(Cnt1sec){
        case 1:
            datetime  = (12UL * rtc[6]) + rtc[5];
            datetime  = (31UL * datetime) + rtc[4];
            datetime  = (24UL * datetime) + rtc[2];
            datetime  = (60UL * datetime) + rtc[1];
            datetime  = (60UL * datetime) + rtc[0];
            datetime -= RackPkt.dlyvsoc;
            break;

        case 2:
            RamPkt.time        = datetime;
            RamPkt.bmsontime   = RackPkt.bmsontime;
            RamPkt.cap         = RackPkt.datacap;
            RamPkt.cyclecap    = RackPkt.cyclecap;
            RamPkt.cyccnt      = RackPkt.cyccnt;
            RamPkt.errcnt      = RackPkt.errcnt;
            RamPkt.norcnt      = RackPkt.norcnt;
            RamPkt.tot_dch_pw  = RackPkt.tot_dch_pw;

            str = (void *)&RamPkt;
            crc = 0x41;
            for(k = 0; k < (sizeof(sMCP7940_Ram)-1U); k++){
                crc = TwiCRC[crc ^ str[k]];
            }
            RamPkt.crc = crc;
            break;

        case 3:
			if (HAL_I2C_GetState(&hi2c1) == HAL_I2C_STATE_READY){
				(void)HAL_I2C_Mem_Write(&hi2c1, SLVMCP7940, MCP7940_SRAM_ADDR,
										I2C_MEMADD_SIZE_8BIT, (uint8_t*)&RamPkt,
										sizeof(sMCP7940_Ram), 50);
			}

            break;

        case 8:
			if (HAL_I2C_GetState(&hi2c1) == HAL_I2C_STATE_READY){
				(void)HAL_I2C_Mem_Write(&hi2c1, SLVMCP7940, MCP7940_SRAM_ADDR + sizeof(sMCP7940_Ram),
										I2C_MEMADD_SIZE_8BIT, (uint8_t*)&RamPkt,
										sizeof(sMCP7940_Ram), 50);
			}

            break;

        default:
            break;
    }
}

