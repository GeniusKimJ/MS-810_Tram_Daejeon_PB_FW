/*Cell 288s*/
void Monitor_CanTx_Cv(Enum_Can_Type eCanType, Enum_McuCan_Type eMcuCan, u8 u8Pos)
{
	u8 i  			= 0;
	u8 txdat[8] 	= {0};
	u16 txcv[4] 	= {4};
	u32 idx 		= (u32)(0x1000+u8Pos); //0x1000~0x1113     288s                                              //KKD 2025-11-26 송신 ID 설정

	memcpy(&txcv[0],RackPkt.TrayPkt[0].cell[0+(u8Pos*4)], 8);

	for(i=0;i<4;i++){
		txdat[0+(i*2)] = (u8)(txcv[i] << 8) & 0xff;
		txdat[1+(i*2)] = (u8)(txcv[i] & 0xff) ;
	}
	Can_TxFifo(eCanType, idx, txdat, eMcuCan);																	//KKD 2025-11-26 Fifo 에 적재
}

void Monitor_CanTx_Th(Enum_Can_Type eCanType, Enum_McuCan_Type eMcuCan, u8 u8Pos)
{
	u8 i  			= 0;
	u8 txdat[8] 	= {0};
	u16 txcv[4] 	= {4};
	u32 idx 		= (u32)(0x2000+u8Pos); //0x1000~0x1113														//KKD 2025-11-26 송신 ID 설정

	memcpy(&txcv[0],(u16)RackPkt.TrayPkt[0].temp[0+(u8Pos*4)], 8);

	for(i=0;i<4;i++){
		txdat[0+(i*2)] = (u8)(txcv[i] << 8) & 0xff;
		txdat[1+(i*2)] = (u8)(txcv[i] & 0xff) ;
	}
	Can_TxFifo(eCanType, idx, txdat, eMcuCan);																	//KKD 2025-11-26 Fifo 에 적재
}



