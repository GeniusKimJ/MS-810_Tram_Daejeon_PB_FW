BOOL Adbms6815_SM31_Adc2_5VRefCheck(sSM_Task *pSm){
    // ADAX ��ȯ �� REF3  5V Check
	u16 cmd = (ADAX|ADBMS6815_GPIO_CH_VREF); 
 	pSm->eSMNum = SM31_Type;
    Adbms6815_Cmd_Write(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir, cmd);
    Delay_ms(2);
