// SM1 : MUX ���ڴ� ���� ���� (DIAGN ���? MUXFAIL �÷��� Ȯ��)
int Adbms6815_SM1_MuxDecoderCheck(sSM_Task *pSm)
{
	pSm->eSMNum = SM1_Type;
	Adbms6815_Cmd_Write(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,DIAGN);
	Delay_ms(2);
	Adbms6815_Daisy_SM_Poll_Read(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,GC_TYPE,RDSTSC,pSm);
	Delay_ms(2);
	return 1;
}

// SM2 : ���� ���� ���� �˻� (ADAX�� VREF2 ����)
int Adbms6815_SM2_InternalRefCheck(sSM_Task *pSm)
{
	u16	cmd		= (ADAX|ADBMS6815_MD_7khz|ADBMS6815_PG_UNIQUE);  
	pSm->eSMNum = SM2_Type;
	Adbms6815_Cmd_Write(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,cmd);
	Delay_ms(2);
	Adbms6815_Daisy_SM_Poll_Read(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,GA_TYPE,RDAXA,pSm);
	return 1;
}


// SM4 : CV openwire : WR: CVOW, RD: Cell Diang group
int Adbms6815_SM4_CellOpenWire(sSM_Task *pSm)
{
	BOOL rtn = FALSE; 
	u8	nslv,nscv;
	u16	diff;
	
	pSm->eSMNum = SM4_Type;
	for(nslv=0; nslv<NSLV; nslv++){
		for(nscv=0; nscv<NSCV; nscv++){
			if((g_sAd6815Data.u16Ow[g_sAd6815Data.eAfe][nslv][nscv] & 0xFFF0 ) == 0x7FA0){
				pSm->u16DtcCount[g_sAd6815Data.eAfe][nslv][pSm->eSMNum]++;
			}else if(g_sAd6815Data.u16Ow[g_sAd6815Data.eAfe][nslv][nscv] == 0x7FC0){
				pSm->u16DtcCount[g_sAd6815Data.eAfe][nslv][pSm->eSMNum]++;
			}else{
				diff = LABS_U16(g_sAd6815Data.u16Cv[g_sAd6815Data.eAfe][nslv][nscv] - g_sAd6815Data.u16Ow[g_sAd6815Data.eAfe][nslv][nscv]);
				if(diff > 30){	 
					pSm->u16DtcCount[g_sAd6815Data.eAfe][nslv][pSm->eSMNum]++;
				}
			}
		}
	}
	if(pSm->u16DtcCount[g_sAd6815Data.eAfe][nslv][pSm->eSMNum] >=0xFFFF){
		pSm->u16DtcCount[g_sAd6815Data.eAfe][nslv][pSm->eSMNum] = 0xFFFF;
	}
	
	if(pSm->u16DtcCount[g_sAd6815Data.eAfe][nslv][pSm->eSMNum]> MAX_DTC_COUNT){
		//todo : err proc. . .
		rtn = TRUE;
	}

	return rtn;
}

// SM7 : ���� ���� ���� ����͸�?(ADSTAT) VREG, VREGD
BOOL Adbms6815_SM7_SupplyVoltageCheck(sSM_Task *pSm)
{
	u16	cmd = (ADSTAT|ADBMS6815_MD_7khz);
	pSm->eSMNum = SM7_Type;
	Adbms6815_Cmd_Write(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,cmd);			
	Delay_ms(2);
	Adbms6815_Daisy_SM_Poll_Read(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,GA_TYPE,RDSTSA,pSm);	
	Delay_ms(2);
	Adbms6815_Daisy_SM_Poll_Read(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,GB_TYPE,RDSTSB,pSm);
	
	return 1;
}

// SM8 : SPI ���?������ CRC/������ TX/RX�� �����ϰ�����
// SM9 : �� ��ø ���� (ADOL, ADC1  cv7 vs ADC2 cv7)
BOOL Adbms6815_SM9_CellOverlap(sSM_Task *pSm)
{
	u16	cmd	= (ADOL|ADBMS6815_MD_7khz);
	pSm->eSMNum = SM9_Type;
	Adbms6815_Cmd_Write(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,cmd);
	Delay_ms(2);
	Adbms6815_Daisy_SM_Poll_Read(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,0,RDSTSC,pSm);

	return TRUE;
}

// SM10 : ���� �������� �����?(CLRAUX) (�ʿ����?
// SM11 : ���� ä�� ���� �������� ���� (AXPG, ���� ���� �� ��) (���� �� ���� ����)
// SM12 : ����ȭ�� �����?�� �µ� ���� (2���� GPIO�� ���� �ߺ� NTC)(�µ� ����ȭ ���� �ƴ�)
// SM13 : �ߺ� ������ ���� (PS ��Ʈ �����Ͽ� 2ȸ ��ȯ �� ��) - adc1/2���� ���� Ȯ��.  SM38�� ��ü
// SM15 : C��-S�� �ܶ� ���� (ADCV with DC=1 vs DC=0 ��)
BOOL Adbms6815_SM15_CSPinShortCheck(sSM_Task *pSm){
    BOOL rtn		= FALSE;
	u8	nslv			= 0;
	u8	nscv			= 0;

	float fbase			= 0.00f;    // DCC OFF ���ذ�
	float fmeas			= 0.00f;	// DCC ON (���� ��) ��
	float fratio		= 0.00f;	// ���� ����
	float fdiffLow 		= 0.75f;
	float fdiffHigh 	= 1.25f;

	pSm->eSMNum = SM15_Type;
	for(nslv=0; nslv<NSLV; nslv++){
		for(nscv=0; nscv<NSCV; nscv++){
			fbase = g_sAd6815Data.u16Cv[g_sAd6815Data.eAfe][nslv][nscv];

			if((nscv % 2) == 0){ 
				fmeas = g_sAd6815Data.u16EvCv[g_sAd6815Data.eAfe][nslv][nscv]; 
			}else{ 
				fmeas = g_sAd6815Data.u16OdCv[g_sAd6815Data.eAfe][nslv][nscv]; 
			}

			fratio = (float)(fmeas / fbase);																// ���� ���?������/���ذ�)

			if(fratio <fdiffLow){ 
				pSm->u16DtcCount[g_sAd6815Data.eAfe][nslv][pSm->eSMNum]++; 																			// <0.75% �̸� | C(n)-S(n) �Ǵ� C(n-1)-S(n-1) ��Ʈ �ǽ�
			}else if(fratio>fdiffHigh){ 
				pSm->u16DtcCount[g_sAd6815Data.eAfe][nslv][pSm->eSMNum]++; 							// >1.25% �ʰ� | S(n+1)-C(n) �Ǵ� S(n)-C(n-1) ��Ʈ �ǽ�
			}
		}
	}
	if(pSm->u16DtcCount[g_sAd6815Data.eAfe][nslv][pSm->eSMNum] >=0xFFFF){
		pSm->u16DtcCount[g_sAd6815Data.eAfe][nslv][pSm->eSMNum] = 0xFFFF;
	}
	
	if(pSm->u16DtcCount[g_sAd6815Data.eAfe][nslv][pSm->eSMNum]> MAX_DTC_COUNT){
		//todo : err proc. . .
		rtn = TRUE;
	}

	return rtn;
}

// SM16 : �� �Է� ���� ���� ���� (ADLEAK, C�� vs S�� ���� ��) ����
// SM17 : ���� ���� ���� ���� (ADSC, ���� ADCV ���� ���� ���� Ȯ��)
BOOL Adbms6815_SM17_SenseLineFaultCheck(sSM_Task *pSm)
{
    BOOL rtn		= FALSE;
	u8	nslv			= 0;
	u8	nscv			= 0;
	
    float fRatio		= 0.0f;
    float fsv   		= 0.0f; 
    float fcv			= 0.0f;

	pSm->eSMNum = SM17_Type;
	for(nslv=0; nslv<NSLV; nslv++){
		for(nscv=0; nscv<NSCV; nscv++){
			fsv = (float)g_sAd6815Data.u16Sv[g_sAd6815Data.eAfe][nslv][nscv];
			fcv = (float)g_sAd6815Data.u16Cv[g_sAd6815Data.eAfe][nslv][nscv];
		
			if(fcv > 10.0f){																				// �븻 ������ 0�� �ƴϸ�
				fRatio = fsv / fcv;
				if((fRatio < 0.1f) || (fRatio > 0.9f)){
					pSm->u16DtcCount[g_sAd6815Data.eAfe][nslv][pSm->eSMNum]++;													// Ratio �ʰ� ����
				}
			}
		}
	}
	if(pSm->u16DtcCount[g_sAd6815Data.eAfe][nslv][pSm->eSMNum] >=0xFFFF){
		pSm->u16DtcCount[g_sAd6815Data.eAfe][nslv][pSm->eSMNum] = 0xFFFF;
	}
	
	if(pSm->u16DtcCount[g_sAd6815Data.eAfe][nslv][pSm->eSMNum]> MAX_DTC_COUNT){
		//todo : err proc. . .
		rtn = TRUE;
	}

	return rtn;
}
#if 0
 // SM19 : Internal Supply Fault Monitoring         - VREG / VREGD ���� (SM7 Ȯ��)
BOOL Adbms6815_SM19_InternalSupplyFault(sSM_Task *pSm)
{
    BOOL rtn = FALSE;
    u8	nslv		= 0;
    u8	nreg		= 0;
    u16	pec_rx	= 0;
    u16	pec_mk	= 0;
    u16	u16vaov_hi	= 0,
    u16	u16vauv_lo	= 0;
    u16	u16vdov_hi	= 0;
	u16	u16vdov_lo	= 0;

    switch(pSm->estate){
        case SM_STATE_INIT: 
        	rtn = FALSE; 
        	break;
        	
        case SM_STATE_START:
            break;
            
        case SM_STATE_READ_STA_1:																			// read single group
            Adbms6815_Daisy_Read_DmaStart(g_sAd6815Data.eComDir,GROUPA, RDSTSC);							// status register c
            break;
            
        case SM_STATE_READ_END_1:
            Adbms6815_Daisy_ReadEnd(g_sAd6815Data.eComDir);	
            // read done
            for(nslv=0;nslv<NSLV;nslv++){												// 
                pec_rx = ((u16)(g_u8Rx[GROUPA][10+(nslv*8)])<<8)+g_u8Rx[GROUPA][11+(nslv*8)];
                pec_mk = Adbms6815_DatPec10(&g_u8Rx[GROUPA][4+(nslv*8)],6,TRUE);
                if(pec_rx==pec_mk){
                    for(nreg=0;nreg<6;nreg++){
                    	reg[nslv][nreg]=g_u8Rx[GROUPA][4+(nslv*8)+nreg];
                   	}
                }
            }break;
            
        case SM_STATE_ANALYZE:
            for(nslv=0;nslv<NSLV;nslv++){
				u16vaov_hi = (reg[nslv][0] &0x80);						// bit 7 vreg analog ov flag chk
				u16vauv_lo = (reg[nslv][0] &0x40);						// bit 6 vreg analog uv flag chk						
				u16vdov_hi = (reg[nslv][0] &0x20);						// bit 5 vreg digital ov flag chk
				u16vdov_lo = (reg[nslv][0] &0x10);						// bit 4 vreg digital uv flag chk

                if((u16vaov_hi|u16vauv_lo|u16vdov_hi|u16vdov_lo) != 0){
                    pSm->u16DtcCount[nslv][pSm->id]++;
                }
            }
            if(pSm->u16DtcCount[nslv][pSm->id] > MAX_DTC_COUNT){
				rtn = TRUE;
			}break;
    }
    if(pSm->estate == SM_STATE_ANALYZE){
    	return rtn;
    }
}
#endif

