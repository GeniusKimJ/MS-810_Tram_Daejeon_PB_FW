    return TRUE;

}

// SM33 : ���� �������� �����?(CLRSTAT) - �������� ��ü Ŭ���� Ȯ��?
// SM34 : ���� ���� ���� ���� (STATC �÷��� Ȯ��)
BOOL Adbms6815_SM34_ChargePumpCheck(sSM_Task *pSm){
    u8 cfgr[MAX_AFE_Type][NSLV][6] = {0,};
    int i = 0, j = 0;

    for( i = 0 ; i < MAX_AFE_Type ; i++ ){
        for( j = 0 ; j < NSLV ; j++ ){
        	cfgr[i][j][0] = (REFON|ADCOPT);  
        	cfgr[i][j][1] = (MN_CP_UVCHK_FAIL);																			// Flag D - Charge Pump Manual Test								// Test Mode : Charge Pump Fault = 1
        	cfgr[i][j][2] = 0x00;
        	cfgr[i][j][3] = 0xFF;
        	cfgr[i][j][4] = 0xFF;
        }
    }

 	pSm->eSMNum = SM34_Type;
	Adbms6815_Daisy_CfgWrite(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,WRCFGA, cfgr);											// Charge Pump ���� fault �߻�
	Adbms6815_Daisy_SM_Poll_Read(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir, GC_TYPE ,RDSTSC,pSm);								// Register Group C ���� CP �÷��� 1���� Ȯ��

    for( i = 0 ; i < MAX_AFE_Type ; i++ ){
        for( j = 0 ; j < NSLV ; j++ ){
	        cfgr[i][j][1] = 0x00;																							// Test Mode �ʱ�ȭ
        }
    }
	Adbms6815_Daisy_CfgWrite(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,WRCFGA, cfgr);
    Adbms6815_Cmd_Write(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,CLRFFLAG);													// Register Group C �ʱ�ȭ
	Adbms6815_Daisy_SM_Poll_Read(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,GC_TYPE ,CLRFFLAG,pSm);								// Register Group C CP�� �÷��� 0���� Ȯ��.

    return TRUE;
}

// SM38 : Die �µ� ���� �µ� �������� Open ���� ������ ����
// SM41 : �ߺ� ������ ���� ���� �׽�Ʈ
BOOL Adbms6815_SM41_FilterDiagTest(sSM_Task *pSm){
	//static u8 tog = 0;
/*	
	u8 cfgr[6] = {0,0,0,0,0,0};
	
	cfgr[0] = (PSH|REFON|ADCOPT);  
	cfgr[2] = 0x00;
	cfgr[3] = 0xFF;
	cfgr[4] = 0xFF;
*/
    // ����: CLRCELL �� WRCFGA �� ADCV (PS=01) �� �� �б� �� ADCV (PS=10) �� �� �б�
 	pSm->eSMNum = SM41_Type;
	Adbms6815_Daisy_SM_Poll_Read(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir, GC_TYPE ,RDSTSC,pSm);								// Register Group C ���� CP �÷��� 1���� Ȯ��																					// Test Mode �ʱ�ȭ
    Adbms6815_Cmd_Write(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,CLRFFLAG);													// Register Group C �ʱ�ȭ
	Delay_ms(1);
	Adbms6815_Daisy_SM_Poll_Read(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,GC_TYPE ,CLRFFLAG,pSm);								// Register Group C CP�� �÷��� 0���� Ȯ��.
    return 1;

}

// SM42 : ���� ���� ���� �����?���� �׽�Ʈ
BOOL Adbms6815_SM42_SupplyDiagTest(void){
    u16 pec_rx	= 0;
    u16 pec_mk	= 0;

    // ����: fault flag clear �� ADC ��ȯ �� RDSTATC
    //Adbms6815_SM33_ClearStatusReg(eComDir);
    //Adbms6815_StartCvAux(g_sAd6815Data.eComDir,ADCV);
    Delay_ms(3);
    Adbms6815_Cmd_Write(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,ADCV);

    pec_rx=((u16)g_u8RxData[10]<<8)|g_u8RxData[11];
    pec_mk=Adbms6815_DatPec10(&g_u8RxData[4],6,TRUE);
    if(pec_rx!=pec_mk){
    	return FALSE;
    }

    // UV/OV fault ���� ���� Ȯ��
    if(g_u8RxData[4] & 0x0C){
    	return FALSE;
    }
    return TRUE;
}

// SM43 : MUX ���ڴ� ���� ���� ȸ�� ���� �׽�Ʈ
BOOL Adbms6815_SM43_MuxDiagTest(void){
    Adbms6815_Cmd_Write(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,DIAGN);

    //Adbms6815_SM33_ClearStatusReg(g_sAd6815Data.eComDir);
    Adbms6815_ChipSel(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,TRUE);
    HAL_SPI_TransmitReceive(&hspi1,g_u8TxData,g_u8RxData,sizeof(g_u8RxData),5);
    Adbms6815_ChipSel(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,FALSE);
    Delay_ms(2);

    //Adbms6815_Write(g_sAd6815Data.eComDir,);
    if(g_u8RxData[4] & 0x01){
    	return FALSE; // MUXFAIL
    }
    return TRUE;
}

// SM44 : ���� ���� ���?���� �����?���� �׽�Ʈ
BOOL Adbms6815_SM44_CpOutDiagTest(void){
    //Adbms6815_SM33_ClearStatusReg(eComDir);																	// clear befo fault status
    //Adbms6815_StartCvAux(g_sAd6815Data.eComDir,ADCV);														// conv start cell v
    Delay_ms(3);
    Adbms6815_Cmd_Write(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,RDSTSC);

    if(g_u8RxData[4] & 0x08){
    	return FALSE; // CPCHK Fail
    }
    return TRUE;
}

// SM45 : Clock �����?���� �׽�Ʈ // don't know..??
BOOL Adbms6815_SM45_ClockDiagTest(sSM_Task *pSm)
{	
	Adbms6815_Cmd_Write(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir,CLRFFLAG);
	Adbms6815_WrCfgA(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir, 0,0,0,0);
	
    //Adbms6815_SM33_ClearStatusReg(eComDir);
   	//Adbms6815_StartCvAux(g_sAd6815Data.eComDir,ADCV);
    Delay_ms(3);
   // Adbms6815_Cmd_Write(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir);

    if(g_u8RxData[5] & 0x20){																				// reg status group C buff[1] : OSCCHK
    	return FALSE; 																						// CLKFAIL
    }
    return TRUE;
}



// SM46 : Cell ���� �������� ���� (CDPG, ���� ���� �� ��)
BOOL Adbms6815_SM46_CellDiagPattern(void){
    int i = 0, j = 0;

	u16 cmd	= (CDPG|ADBMS6815_MD_7khz|ADBMS6815_PG_UNIQUE);
    
    Adbms6815_Cmd_Write(g_sAd6815Data.eAfe, g_sAd6815Data.eComDir,cmd);

    Adbms6815_ChipSel(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir, TRUE);
    Adbms6815_ChipSel(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir, FALSE);

    Delay_ms(2);

    // read pattern (Cell Voltage Register Group A)
    //Adbms6815_RdCv(g_sAd6815Data.eComDir, Group_A_Type);
    //Adbms6815_CastCv(g_sAd6815Data.eComDir, Group_A_Type);

    // compare pattern (neet pattern value)

    for( i = 0 ; i < NAFE ; i++ ){
        for( j = 0 ; j < NSLV ; j++ ){
            if(g_sAd6815Data.u16Cv[i][j][0] != (u16)0x1234){
            	return FALSE;
            }
        }
    }
    
    return TRUE;
}

// SM50 : ���� �������� ���� (STATPG, ���� ���� �� ��)
BOOL Adbms6815_SM50_StatusRegPattern(void){
//	u16 cmd		= (STATPG|ADBMS6815_MD_7khz|ADBMS6815_PG_UNIQUE);
	u16 pec_rx	= 0;
	u16 pec_mk	= 0;

	Adbms6815_Cmd_Write(g_sAd6815Data.eAfe,g_sAd6815Data.eComDir, STATPG);
    Delay_ms(2);
	Adbms6815_Daisy_Read_DmaStart(g_sAd6815Data.eAfe, g_sAd6815Data.eComDir, GC_TYPE, RDSTSC);   								// ���� �������� �׷� C �б�


    pec_rx = ((u16)g_u8RxData[10] << 8) | g_u8RxData[11];
    pec_mk = Adbms6815_DatPec10(&g_u8RxData[4], 6, TRUE);
    if(pec_rx != pec_mk){
    	return FALSE;
    }

    // Compare pattern - need pattern value!
    if(g_u8RxData[4] != 0x55){
    	return FALSE;
	}
    return TRUE;
}



