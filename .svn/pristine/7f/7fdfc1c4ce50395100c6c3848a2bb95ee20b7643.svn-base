	/*EEP*/
	Eep_ReadSysInfo();
	EEP_ReadCalData();
}

void Proc_Calcul_CvTh(Pkt_Rack *pBmsData)
{
	s16	max = 0, min = 0;
	u8	cnt 	= 0;
	u8	min_num	= 0;
	u8	max_num	= 0;
	s32	avgth	= 0;
	u32	avgsum	= 0;
	u32	u32_buf	= 0;

    memcpy(pBmsData->TrayPkt[0].cell,&g_sAd6815Data.u16Cv,sizeof(g_sAd6815Data.u16Cv));
    memcpy(pBmsData->TrayPkt[0].temp,&g_sAd6815Data.s16Th,sizeof(g_sAd6815Data.s16Th));

	avgth = 0;
	max = (s16)-32768;
	min = (s16)32767;
	for(cnt = 0; cnt < (NTH); cnt++) {
		if(pBmsData->TrayPkt[0].temp[cnt] > max) {
			max = pBmsData->TrayPkt[0].temp[cnt];
			max_num = cnt;
		}
		if(pBmsData->TrayPkt[0].temp[cnt] < min) {
			min = pBmsData->TrayPkt[0].temp[cnt];
			min_num = cnt;
		}
		avgth += pBmsData->TrayPkt[0].temp[cnt];
	}
	pBmsData->maxth	= max;
	pBmsData->maxth	= (u8)(max_num+1U);
	pBmsData->minth	= min;
	pBmsData->minth	= (u8)(min_num+1U);
	//pBmsData->avgth  = (s16)avgth/(s16)(MAXNTH-2U);
	pBmsData->avgth 	= (s16)avgth/(s16)(NTH);
	pBmsData->diffth	= max-min;
	
	avgsum	= 0;
	max		= 0;
	min		= 32767;
	for(cnt = 0; cnt < NCV; cnt++) {
		if(pBmsData->TrayPkt[0].cell[cnt] > (u32)max) {
			max = (s16)pBmsData->TrayPkt[0].cell[cnt];
			max_num = cnt;
		}
		if(pBmsData->TrayPkt[0].cell[cnt] < (u32)min) {
			min = (s16)pBmsData->TrayPkt[0].cell[cnt];
			min_num = cnt;
		}
		avgsum += pBmsData->TrayPkt[0].cell[cnt];
	}
	pBmsData->maxcv	= (u16)max;
	pBmsData->maxcvn	= max_num+1U;
	pBmsData->mincv	= (u16)min;
	pBmsData->mincvn	= min_num+1U;
	pBmsData->sumcv	= avgsum;
	pBmsData->pv[PVINP]= RackPkt.sumcv;
	
	u32_buf			= avgsum/(u32)(NCV);
	pBmsData->avgcv	= (u16)(u32_buf);
	pBmsData->diffcv	= max-min;
}

s32 Proc_MovAvg(s32 u32Data, eMovAvg ePos){
	static s32	s_lawbuff[MAX_MOV][MOVCNT] = {0};
	static u8	s_first[MAX_MOV]	= {0};
	static u8	s_movcnt[MAX_MOV] 	= {0};
	static u8	s_movpos[MAX_MOV] 	= {0};
	s32 		movsum[MAX_MOV]		= {0};
	s32 		movavg[MAX_MOV]		= {0};
	u8			i = 0;
	
	if(s_first[ePos] == 0U){
		s_first[ePos] = 1;
		for(i=0;i<s_movcnt[ePos];i++){
			s_lawbuff[ePos][i] = u32Data;
		}
	}else{
		s_lawbuff[ePos][s_movpos[ePos]] = u32Data;
	}

	if(++s_movpos[ePos] >= (u8)MOVCNT){
		s_movpos[ePos] = 0;
	}
	if(++s_movcnt[ePos] >= (u8)MOVCNT){
		s_movcnt[ePos] = (u8)MOVCNT;
	}

	for(i=0;i<s_movcnt[ePos];i++){
		movsum[ePos] += s_lawbuff[ePos][i];
	}

	if(s_movcnt[ePos] == 0U){
		movavg[ePos] = 0;
	}else{
		movavg[ePos] = (movsum[ePos]/(s32)s_movcnt[ePos]);
	}

	return movavg[ePos];
}

void Proc_CellBalance(s32 pi) {
	u8	num;
	static u8		DelayBalO[NCV];
	static u8		DelayBalR[NCV];
	static u32		bal = 0U;

	if((-2000 < pi) && (pi < 10000)) {		// -2.000A ~ 10.000A
		for(num = 0; num < NCV; num++) {
			if((RackPkt.TrayPkt[0].cell[num] >= UBMAX)||((RackPkt.TrayPkt[0].cell[num] >= UBMIN)&&(RackPkt.TrayPkt[0].cell[num] >= (RackPkt.mincv+UBOPR)))) {
				if((++DelayBalO[num] >= DLYBALO)) {
					bal |= (1UL<<num);
					--DelayBalO[num];
				}
			} else {
				DelayBalO[num] = 0U;
			}

			if((RackPkt.TrayPkt[0].cell[num] < UBMAX)&&((RackPkt.TrayPkt[0].cell[num] < UBMIN)||(RackPkt.TrayPkt[0].cell[num] < (RackPkt.mincv+UBSTP)))) {
				if(++DelayBalR[num] >= DLYBALR) {
					bal &= ~(1UL<<num);
					--DelayBalR[num];
				}
			} else {
				DelayBalR[num] = 0U;
			}
		}
	} else {
		for(num = 0; num < NCV; num++) {
			DelayBalO[num] = 0U;
			DelayBalR[num] = 0U;
		}
	}RackPkt.TrayPkt[0].fbalance = bal;
}
void Proc_Io(void)
{
	Gpio_Led();
	Gpio_Fault_Out();
	Gpio_Ch_In();
	Gpio_Hv_In();
}
void Proc_Afe(void)
{
	
#ifdef USE_ADBMS_B_TEST    //2026-01-16   jkpark  ADBMS_B 테스트 코드.

	g_sAd6815Data.eComDir = ComDir_A_Type; 

#else  //USE_ADBMS_B_TEST
	if(g_u8CanDbgStatus == TRUE) {
		g_sAd6815Data.eComDir = ComDir_B_Type; 
	}else{
		g_sAd6815Data.eComDir = ComDir_A_Type; 
	}
#endif //USE_ADBMS_B_TEST
	Adbms6815_Cal_AfePos(g_sAd6815Data.eComDir,WR_WR_Type);
	Adbms6815_NorCell_Proc();
	Adbms6815_NorTh_Proc();
}

void Proc_SensorCheck(void)
{
	IMD_Proc();
	HALL_Proc();
	Fire_Proc();
	HUMI_Proc();
	GAS_Proc();
}
