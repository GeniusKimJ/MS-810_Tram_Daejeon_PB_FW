}

void Proc_Detection(Pkt_Rack *pBmsData)
{
	pBmsData->falm = Alarm_Occur();
	pBmsData->falm = Alarm_Release();
	pBmsData->falm = Det_Occur();
	pBmsData->falm = Det_Release();
}

void Proc_Current(Pkt_Rack *pBmsData)
{
	/* HALL CAB1500 */
	if(g_bSenIcRxDone[SenIC_HALL_Type] == TRUE){
		g_bSenIcRxDone[SenIC_HALL_Type] = FALSE;
		HALL_CanRxParsing(&g_sHallData, g_u8SenIcRxData[SenIC_HALL_Type] );              																//KKD 2025-11-24 Get Current
	}
	HALL_CanRx_TimeoutCheck(&g_sHallData);                                              																//KKD 2025-12-02 CAN Rx Alive Check
	HALL_DiagnosicCheck(&g_sHallData);      

	/* HALL S124 */
	HALL_s124_GetCurrent();
}

void Proc_Relay(void)
{
	Relay_01_Status(&g_sRelayStatus);
	Relay_02_Control(&g_sRelayStatus);
	Relay_03_Feedback(&g_sRelayStatus);
	Relay_04_Diagnosic(&g_sRelayStatus);
}

