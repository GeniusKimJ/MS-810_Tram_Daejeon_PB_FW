{
	Uart1_Rx1Function();

}

//KKD 26-01-06	ext can Manual test
void Proc_MenualTest(void)
{
	//(KKD) Init set v/t 
		memset(g_sMn.mn_cv,(u16)3800,sizeof(g_sMn.mn_cv));
		memset(g_sMn.mn_th,(s16)250,sizeof(g_sMn.mn_th));

	//(KKD) Volt Return when range is exceeded
		if(g_sMn.mn_set_cvpos < 0 && g_sMn.mn_set_cvpos > NCV) 				{return;}
		if(g_sMn.mn_set_cv < (u16)1500 && g_sMn.mn_set_cv > (u16)5000) 		{return;}

		if(g_sMn.mn_set_cvpos < NCV){
			g_sMn.mn_cv[g_sMn.mn_set_cvpos] = g_sMn.mn_set_cv;
		}else{
			memset(g_sMn.mn_cv,g_sMn.mn_set_cv,sizeof(g_sMn.mn_cv));
		}

	//(KKD) Temp Return when range is exceeded
		if(g_sMn.mn_set_thpos < 0 && g_sMn.mn_set_thpos > NTH) 				{return;}
		if(g_sMn.mn_set_th <(s16)(-400) && g_sMn.mn_set_th > (s16)(900))	{return;}

		if(g_sMn.mn_set_thpos < NTH){
			g_sMn.mn_th[g_sMn.mn_set_thpos] = g_sMn.mn_set_th;
		}else{
			memset(g_sMn.mn_th,g_sMn.mn_set_th,sizeof(g_sMn.mn_th));
		}

	//(KKD) To be implemented...
		//curr
		//soc
		//pv
		//relay test
		g_sRelayStatus.u8HvRly_Status = g_sMn.mn_set_rlysts;
		GPIO_DOut_MTOP_RLY(g_sRelayStatus.u8HvRly_Status & (MPCK));
		GPIO_DOut_MBTM_RLY(g_sRelayStatus.u8HvRly_Status & (MNCK));
		GPIO_DOut_MPRE_RLY(g_sRelayStatus.u8HvRly_Status & (MPRE));	//main

		GPIO_DOut_BTOP_RLY(g_sRelayStatus.u8HvRly_Status & (BPCK));
		GPIO_DOut_BBTM_RLY(g_sRelayStatus.u8HvRly_Status & (BNCK));
		GPIO_DOut_BPRE_RLY(g_sRelayStatus.u8HvRly_Status & (BPRE));


	// (KKD) balance test
		 g_sMn.mn_set_bal_flag[g_sMn.mn_set_bal_afe_pos][g_sMn.mn_set_bal_slv_pos] = (1<< g_sMn.mn_set_bal_cell_pos);
	
}

