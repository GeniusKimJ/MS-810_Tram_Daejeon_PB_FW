					Uart1_Uart1BootFunction();
					for(u32 mm = 0; mm < sizeof(Pkt_Uart1_Rxd); mm++) {
						Rx1UartBuf[mm] = 0x00;
					}
				}
		}
		//if(CanBootBreak1ms == 0U) {
		//	fBoot_mode = EXIT;
		//}
	   //continue;
   }
}

