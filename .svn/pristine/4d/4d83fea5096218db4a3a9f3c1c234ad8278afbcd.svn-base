{
    memset( &gBTMS_Data, 0x00, sizeof( sBTMS_DataType ));
    GPIO_DOut_EN485(TRUE);
	HAL_UART_Receive_DMA(&huart3, gBTMS_Data.u8RxDmaBuf, sizeof(gBTMS_Data.u8RxDmaBuf));			// uart4 init (display)
}

