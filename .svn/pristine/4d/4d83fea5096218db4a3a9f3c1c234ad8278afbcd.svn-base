void BTMS_Receive_DMA_Poll(void)
{
    u16 currPos = 0;                         //jkpark 2025-12-31 데이터 인덱스 확인.

    if( huart3.hdmarx->State != HAL_DMA_STATE_BUSY )
    {
        //jkpark 2026-01-07 DMA가 동작 상태가 아니면 재시작.
        gBTMS_Data.u16PrevPos	= 0;                                                      	//KKD 2025-11-26 init RxData Position
        gBTMS_Data.bRxOk		= 0;                                                      	//KKD 2025-11-26 Deinit Rx Finished Flag 

        memset( gBTMS_Data.u8RxDmaBuf, 0x00, BTMS_RX_MAX );

        HAL_UART_Receive_DMA(&huart3, gBTMS_Data.u8RxDmaBuf, BTMS_RX_MAX);                   //KKD 2025-11-28 DMA 시작
    }
    else
    {
        currPos = (((u16)BTMS_RX_MAX) - (u16)(__HAL_DMA_GET_COUNTER(huart3.hdmarx)));                         //jkpark 2025-12-31 데이터 인덱스 확인.

        while ( gBTMS_Data.u16PrevPos != currPos ){                                         //jkpark 2025-12-31 저장된 인덱스와 현재 인덱스가 다르면 데이터 입력.
            BTMS_RxFrameParser( gBTMS_Data.u8RxDmaBuf[ gBTMS_Data.u16PrevPos++ ] );
            if (gBTMS_Data.u16PrevPos >= BTMS_RX_MAX){
                gBTMS_Data.u16PrevPos = 0;
           	}
        }
    }

}

void BTMS_RxData_ReParser( void )
{
    gBTMS_Data.ePacket      = BTMS_PACKET_STX;
    gBTMS_Data.u16DataPos   = 0;
}

void BTMS_RxFrameParser(u8 readByte){

    switch( gBTMS_Data.ePacket )
    {
        case BTMS_PACKET_STX:
            if (readByte == BTMS_STX ){                                                              //KKD 2025-11-26 RxData [0] == Start Check
                gBTMS_Data.ePacket = BTMS_PACKET_LEN;
                gBTMS_Data.u16DataPos = 0;
                gBTMS_Data.u8RxDataFrameBuf[gBTMS_Data.u16DataPos++] = readByte;
            }
            break;
        case BTMS_PACKET_LEN:
            if( readByte <= BTMS_RX_DATA_MAX ){
                gBTMS_Data.u8RxDataFrameBuf[gBTMS_Data.u16DataPos++] = readByte;
                gBTMS_Data.u16DataLen  = readByte;
            	gBTMS_Data.u16StateLen = 0;
                if( gBTMS_Data.u16DataLen == BTMS_CRC_LEN )
                {
                    gBTMS_Data.ePacket = BTMS_PACKET_CRC;
                }
                else
                {
                    gBTMS_Data.ePacket = BTMS_PACKET_DATA;
                }
            }
            else
            {
                BTMS_RxData_ReParser();                                              //jkpark 2025-12-31 Length가 오류면 Start를 다시 검색.            
            }
            break;
        case BTMS_PACKET_DATA:
            gBTMS_Data.u8RxDataFrameBuf[gBTMS_Data.u16DataPos++] = readByte;
            gBTMS_Data.u16StateLen++;
            if( gBTMS_Data.u16StateLen >= gBTMS_Data.u16DataLen )
            {
                gBTMS_Data.u16StateLen = 0;
                gBTMS_Data.ePacket = BTMS_PACKET_CRC;
            }
            break;
        case BTMS_PACKET_CRC:
            gBTMS_Data.u8RxDataFrameBuf[gBTMS_Data.u16DataPos++] = readByte;
            gBTMS_Data.u16StateLen++;
            if( gBTMS_Data.u16StateLen == BTMS_CRC_LEN )
            {
                u16 crc_rx = ((u16)gBTMS_Data.u8RxDataFrameBuf[ gBTMS_Data.u16DataPos - 2 ] << 8) | gBTMS_Data.u8RxDataFrameBuf[ g_sMvbData.u16DataPos - 1 ];
                u16 crc_calc = crc16_ibm3740((const u8 *)&gBTMS_Data.u8RxDataFrameBuf[BTMS_LEN_IDX], (u32)(gBTMS_Data.u16DataLen + BTMS_LEN_LEN - BTMS_CRC_LEN) );

                if( crc_rx == crc_calc ){
                    gBTMS_Data.u16StateLen = 0;
                    gBTMS_Data.ePacket = BTMS_PACKET_ETX;
                }
                else
                {
                    BTMS_RxData_ReParser();                                              //jkpark 2025-12-31 CRC가 오류면 Start를 다시 검색.
                }
            }
            break;
        case BTMS_PACKET_ETX:    
            if ( readByte == BTMS_PACKET_ETX ){                                                              //KKD 2025-11-26 RxData [0] == Start Check
                gBTMS_Data.ePacket = BTMS_PACKET_STX;
                gBTMS_Data.u16DataPos = 0;
                gBTMS_Data.u8RxDataFrameBuf[gBTMS_Data.u16DataPos++] = readByte;
                gBTMS_Data.bRxOk = 1;
            }
            else
            {
                BTMS_RxData_ReParser();                                              //jkpark 2025-12-31 MVB_ENDER가 오류면 Start를 다시 검색.
            }
            break;
        default:
            BTMS_RxData_ReParser();                                                  //jkpark 2025-12-31 g_sMvbData.eState가 오류면 초기화 하고 Start를 다시 검색.            
            break;
    }
}

void BTMS_CmdProc(const uint8_t *data, uint32_t len)
{
    const char *aCmdStr[]= 
        {   "START",
            "Target_Temp",
            "Status",
            "Temp_Status",
            "Humidity_Status",
            NULL
        };
    int cmdID = 0;

    for( cmdID = 0 ; aCmdStr[ cmdID ] != NULL; cmdID++ )
    {
        if( strncmp( (const char *)data,aCmdStr[ cmdID ],strlen(aCmdStr[ cmdID ])) == 0 )
        {
            break;
        }
    }

    switch( cmdID )
    {
        case BTMS_CMD_START:
            break;
        case BTMS_CMD_TARGET_TEMP:
            break;
        case BTMS_CMD_STATUS:
            break;
        case BTMS_CMD_TEMP_STATUS:
            break;
        case BTMS_CMD_HUMIDITY_STATUS:
            break;
        default:
            break;
    }

    return;
}

#if 0
u16 crc16_ibm3740(const u8 *data, u32 len)
{
    uint16_t crc = CRC16_IBM3740_INIT;

    while (len--)
    {
        crc ^= ((uint16_t)*data++) << 8U;

        for (int i = 0; i < 8; ++i)
        {
            if (crc & 0x8000U)
            {
                crc = (uint16_t)((crc << 1) ^ CRC16_IBM3740_POLY);
            }
            else
            {
                crc <<= 1;
            }
        }
    }

    return (uint16_t)(crc ^ CRC16_IBM3740_XOROUT);
}
#endif

