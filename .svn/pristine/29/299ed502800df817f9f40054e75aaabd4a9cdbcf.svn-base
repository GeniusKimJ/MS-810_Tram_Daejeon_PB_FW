void Can_Tx_01_TimeDate(Enum_Can_Type eCanType, Enum_McuCan_Type eMcuCan)
{
	u8 txdat[8]	= {0};
	u32 idx     = (u32)(0x10);

	memcpy(txdat,(RackPkt.rtc),sizeof(RackPkt.rtc));
	Can_TxFifo(eCanType, idx, txdat, eMcuCan);
}

void Can_Tx_02_Summery(Enum_Can_Type eCanType, Enum_McuCan_Type eMcuCan)
{
	u8 txdat[8]	= {0};
	u16 tmp		= 0;
	u32 idx     = (u32)(0x11);

	tmp  = RackPkt.soc;
	txdat[0] = (u8)(tmp & 0xff);
	txdat[1] = (u8)((tmp >> 8) & 0xff);

	tmp  = RackPkt.soh;
	txdat[2] = (u8)(tmp & 0xff);
	txdat[3] = (u8)((tmp >> 8) & 0xff);

	if(RackPkt.fdet != 0) { txdat[4] = (u8)(1<<0); }
	if(RackPkt.falm != 0) { txdat[4] |= (u8)(1<<1); }
	
	txdat[6] = (u8)g_sRelayStatus.u8HvRly_Status;
	txdat[7] = (u8)g_sRelayStatus.u8HvRly_Feedback;
	
	Can_TxFifo(eCanType, idx, txdat, eMcuCan);
}
void Can_Tx_03_Summery_PV(Enum_Can_Type eCanType, Enum_McuCan_Type eMcuCan)
{
	u8 txdat[8]	= {0};
	u32 idx     = (u32)(0x12);
	//Todo...

	Can_TxFifo(eCanType, idx, txdat, eMcuCan);
}

void Can_Tx_04_Summery_CV(Enum_Can_Type eCanType, Enum_McuCan_Type eMcuCan)
{
	u8 txdat[8]	= {0};
	u16 tmp		= 0;
	u32 idx     = (u32)(0x13);

	tmp	= RackPkt.TrayPkt[0].maxcv;
	txdat[0] = (u8)(tmp & 0xff);
	txdat[1] = (u8)((tmp >> 8) & 0xff);
	
	tmp	= RackPkt.TrayPkt[0].mincv;
	txdat[2] = (u8)(tmp & 0xff);
	txdat[3] = (u8)((tmp >> 8) & 0xff);

	tmp	= RackPkt.TrayPkt[0].avgcv;
	txdat[4] = (u8)(tmp & 0xff);
	txdat[5] = (u8)((tmp >> 8) & 0xff);
	
	Can_TxFifo(eCanType, idx, txdat, eMcuCan);
}
void Can_Tx_05_Summery_TH(Enum_Can_Type eCanType, Enum_McuCan_Type eMcuCan)
{
	u8 txdat[8]	= {0};
	s16 tmp		= 0;
	u32 idx     = (u32)(0x14);

	tmp	= RackPkt.TrayPkt[0].maxth;
	txdat[0] = (u8)(tmp & 0xff);
	txdat[1] = (u8)((tmp >> 8) & 0xff);
	
	tmp	= RackPkt.TrayPkt[0].minth;
	txdat[2] = (u8)(tmp & 0xff);
	txdat[3] = (u8)((tmp >> 8) & 0xff);

	tmp	= RackPkt.TrayPkt[0].avgth;
	txdat[4] = (u8)(tmp & 0xff);
	txdat[5] = (u8)((tmp >> 8) & 0xff);
	
	Can_TxFifo(eCanType, idx, txdat, eMcuCan);
}

void Can_Tx_06_AlarmDet(Enum_Can_Type eCanType, Enum_McuCan_Type eMcuCan)
{
	u8 txdat[8]   = {0};
	u32 idx 	  = (u32)(0x15);
	
	memcpy(&txdat[0],(&RackPkt.falm),sizeof(RackPkt.falm));
	memcpy(&txdat[4],(&RackPkt.fdet),sizeof(RackPkt.fdet));
	Can_TxFifo(eCanType, idx, txdat, eMcuCan);
}

void Can_Tx_07_AdCvComFail(Enum_Can_Type eCanType, Enum_McuCan_Type eMcuCan, u8 u8SlvPos)
{
	u8 txdat[8]   = {0};
	u32 idx 	  = (u32)(0x16);

	txdat[0] = 0+u8SlvPos;

	if(u8SlvPos < 3){
		memcpy(&txdat[1],&g_sAd6815Data.u8ReadFailCheck[0][(u8SlvPos*7)], ( sizeof(txdat) - 1 ) );
	}else{
		memcpy(&txdat[1],&g_sAd6815Data.u8ReadFailCheck[0][(u8SlvPos*7)],4);
	}
	Can_TxFifo(eCanType, idx, txdat, eMcuCan);
}

