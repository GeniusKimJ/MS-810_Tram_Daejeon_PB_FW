/*Cell 288s*/
void Can_Tx_Cv(Enum_Can_Type eCanType, Enum_McuCan_Type eMcuCan, u8 u8Pos)
{
	u16 txdat[4] 	= {0};
	u32 idx 		= (u32)(0x1000+u8Pos); //0x1000~0x1113     288s                                              										//KKD 2025-11-26 송신 ID 설정

	memcpy(&txdat[0],(u16*)&RackPkt.TrayPkt[0].cell[0+(u8Pos*4)], 8);
	Can_TxFifo(eCanType, idx, (u8*)&txdat, eMcuCan);																											//KKD 2025-11-26 Fifo 에 적재
}

void Can_Tx_Th(Enum_Can_Type eCanType, Enum_McuCan_Type eMcuCan, u8 u8Pos)
{
	s16 txdat[4] 	= {0};
	u32 idx 		= (u32)(0x2000+u8Pos); //0x1000~0x1113																								//KKD 2025-11-26 송신 ID 설정

	memcpy(&txdat[0],(s16*)&RackPkt.TrayPkt[0].temp[0+(u8Pos*4)], 8);
	Can_TxFifo(eCanType, idx, (u8*)&txdat, eMcuCan);																											//KKD 2025-11-26 Fifo 에 적재
}


void Can_Proc(void)
{
#ifdef CAN_BUF_UPATE    //2025-12-02   jkpark  Can Buffer 관련 수정.
    u32    readId = 0;
    
    while( Can_RxParser( &readId ) == MS_SUCCESS );

    //jkpark 2025-12-05 Rx로 명령을 받지 않아도 주기적으로 실행될 필요가 있는 경우 처리.
    HALL_Proc(void)();
    GAS_Proc();
    IMD_Proc();
    
#else  //CAN_BUF_UPATE
	u8 cnt = 0;
	Can_Tx_01_TimeDate(Can_Extended_Type,McuCan_Ext_Type);																								// KKD 2025-11-26	timddate  
	Can_Tx_02_Summery(Can_Extended_Type,McuCan_Ext_Type);																								// KKD 2026-01-12	soc/soh/alm/det
	Can_Tx_03_Summery_PV(Can_Extended_Type,McuCan_Ext_Type);																							// KKD 2026-01-12	pv in/out/batt _ adding (Todo. . .)
	Can_Tx_04_Summery_CV(Can_Extended_Type,McuCan_Ext_Type);																							// KKD 2026-01-12	cv avg/max/min
	Can_Tx_05_Summery_TH(Can_Extended_Type,McuCan_Ext_Type);																							// KKD 2026-01-12	th avg/max/min
	Can_Tx_06_AlarmDet(Can_Extended_Type,McuCan_Ext_Type);																								// KKD 2026-01-12	alm/det flag
	for(cnt=0;cnt<3;cnt++){
		Can_Tx_07_AdCvComFail(McuCan_Ext_Type,McuCan_Ext_Type,cnt);
	}
	for(cnt=0;cnt<(u8)(NSLV*2);cnt++){
		Can_Tx_Cv(Can_Extended_Type,McuCan_Ext_Type,cnt);
	}
	
	for(cnt=0;cnt<(u8)NSLV;cnt++){
		Can_Tx_Th(Can_Extended_Type,McuCan_Ext_Type,cnt);
	}

#endif //CAN_BUF_UPATE
}

