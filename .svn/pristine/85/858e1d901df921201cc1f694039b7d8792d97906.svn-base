				for(spinum=0;spinum<2;spinum++) { Adbms6815_WrCfgA(spinum,dir,0,0,1,1);}																// cfg a
				for(spinum=0;spinum<2;spinum++) { Adbms8615_WrcfgBal_EvenOdd(spinum,dir,ODD);}															// cfg b (bal start) odd
				break;
			case ADC_SV_Type:
				break;
			case ADC_OW_Type:
				break;
			case ADC_CH1_Type:
				for(spinum=0;spinum<2;spinum++) { Adbms6815_WrCfgA(spinum,dir,PSL,FLAGD5,0,0);}															// sm 41
				break;
			case ADC_CH2_Type:
				for(spinum=0;spinum<2;spinum++) { Adbms6815_WrCfgA(spinum,dir,PSH,FLAGD5,0,0);}															// sm 41
				break;
			default:
				break;
		}
		for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GB_TYPE, pad->u16Cv,READ_CV_Type);}
	}else if(s_u16cnt == 45){
		switch(sadtype)
		{
			case ADC_EV_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Cmd_Write(spinum,dir,ADCV);}									break;		// cv evn start conv	
			case ADC_OD_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Cmd_Write(spinum,dir,ADCV);}									break;		// cv odd start conv
			case ADC_SV_Type:
				for(spinum=0;spinum<2;spinum++) { 
					for(k=0;k<6;k++){
						Adbms6815_Cmd_Write(spinum,dir,ADSC|DC|(k+1));															// sv start conv 480us *6	
						Delay_us(500);
					}
				}break;
			case ADC_OW_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Cmd_Write(spinum,dir,CVOW);}									break;		// ow start conv	
			case ADC_CH1_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Cmd_Write(spinum,dir,ADCV); }									break;		// cv adc1 start conv	
			case ADC_CH2_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Cmd_Write(spinum,dir,ADCV);}									break;		// cv adc2 start conv
		}
	}
	else if(s_u16cnt == 55)
	{
		switch(sadtype){
			case ADC_EV_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GA_TYPE,RDCVA);}						break;		// cv evn read sta	A conv	
			case ADC_OD_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GA_TYPE,RDCVA);}						break;		// cv odd read sta 	A conv	
			case ADC_SV_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GA_TYPE,RDCDA);}						break;		// sv read sta		A conv	
			case ADC_OW_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GA_TYPE,RDCDA);}						break;		// ow read sta		A conv	
			case ADC_CH1_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GA_TYPE,RDCVA);}						break;		// cv adc1 read sta	A conv	
			case ADC_CH2_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GA_TYPE,RDCVA);}						break;		// cv adc2 read sta	A conv
		}
	}
	else if(s_u16cnt == 65)
	{
		switch(sadtype){
			case ADC_EV_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GB_TYPE,RDCVB);}						break;		// cv evn read sta	B conv
			case ADC_OD_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GB_TYPE,RDCVB);}						break;		// cv odd read sta 	B conv
			case ADC_SV_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GB_TYPE,RDCDB);}						break;		// sv read sta		B conv		
			case ADC_OW_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GB_TYPE,RDCDB);}						break;		// ow read sta		B conv
			case ADC_CH1_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GB_TYPE,RDCVB);}						break;		// cv adc1 read sta	B conv	
			case ADC_CH2_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GB_TYPE,RDCVB);}						break;		// cv adc2 read sta	B conv
		}
		switch(sadtype){
			case ADC_EV_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GA_TYPE,pad->u16EvCv,READ_CV_Type); } 	break;		// cv evn read end	A cast
			case ADC_OD_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GA_TYPE,pad->u16OdCv,READ_CV_Type);}   break;		// cv odd read end 	A cast
			case ADC_SV_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GA_TYPE,pad->u16Sv,READ_CV_Type);}		break;		// sv read end		A cast		
			case ADC_OW_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GA_TYPE,pad->u16Ow,READ_CV_Type);}	  	break;		// ow read end		A cast		
			case ADC_CH1_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GA_TYPE,pad->u16Ad1Cv,READ_CV_Type); }	break;		// cv adc1 read end	A cast		
			case ADC_CH2_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GA_TYPE,pad->u16Ad2Cv,READ_CV_Type); }	break;		// cv adc2 read end	A cast		
		}
	}
	else if(s_u16cnt == 75)
	{
		switch(sadtype){
			case ADC_EV_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GC_TYPE,RDCVC);}						break;		// cv evn read sta	C conv
			case ADC_OD_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GC_TYPE,RDCVC);}						break;		// cv odd read sta 	C conv
			case ADC_SV_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GC_TYPE,RDCDC);}						break;		// sv read sta		C conv
			case ADC_OW_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GC_TYPE,RDCDC);}						break;		// ow read sta		C conv
			case ADC_CH1_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GC_TYPE,RDCVC);}						break;		// cv adc1 read sta	C conv
			case ADC_CH2_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GC_TYPE,RDCVC);}						break;		// cv adc2 read sta	C conv
		}
		switch(sadtype){
			case ADC_EV_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GB_TYPE,pad->u16EvCv,READ_CV_Type);}	break;		// cv evn read end	B cast
			case ADC_OD_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GB_TYPE,pad->u16OdCv,READ_CV_Type);}	break;		// cv odd read end 	B cast
			case ADC_SV_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GB_TYPE,pad->u16Sv,READ_CV_Type);}		break;		// sv read end		B cast	
			case ADC_OW_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GB_TYPE,pad->u16Ow,READ_CV_Type);}		break;		// ow read end		B cast	
			case ADC_CH1_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GB_TYPE,pad->u16Ad1Cv,READ_CV_Type);}	break;		// cv adc1 read end	B cast
			case ADC_CH2_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GB_TYPE,pad->u16Ad2Cv,READ_CV_Type);}	break;		// cv adc2 read end	B cast
		}
	}
	else if(s_u16cnt == 85)
	{
		Adbms6815_Cmd_Write(spinum,dir,ADAX);																							// th start conversion
		switch(sadtype){
			case ADC_EV_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GC_TYPE,pad->u16EvCv,READ_CV_Type);}	break;		// cv evn read end	C cast
			case ADC_OD_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GC_TYPE,pad->u16OdCv,READ_CV_Type);}	break;		// cv odd read end 	C cast
			case ADC_SV_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GC_TYPE,pad->u16Sv,READ_CV_Type);}		break;		// sv read end		C cast		
			case ADC_OW_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GC_TYPE,pad->u16Ow,READ_CV_Type);}		break;		// ow read end		C cast		
			case ADC_CH1_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GC_TYPE,pad->u16Ad1Cv,READ_CV_Type);}	break;		// cv adc1 read end	C cast		
			case ADC_CH2_Type:	for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GC_TYPE,pad->u16Ad2Cv,READ_CV_Type);}	break;		// cv adc2 read end	C cast		
		}
		for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GA_TYPE,RDAXA);}												// th read sta		A conv
	}
	else if(s_u16cnt == 50)
	{
		for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GB_TYPE,RDAXB);}												// th read sta		B conv
		for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GA_TYPE,pad->u16Cv,READ_TH_Type);}								// th read end		A cast
	}
	else if(s_u16cnt == 60)
	{
		for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaStart(spinum,dir,GC_TYPE,RDAXC);}												// th read sta		C conv
		for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GB_TYPE,pad->u16Cv,READ_TH_Type);}								// th read end		B cast
	}
	else if(s_u16cnt == 70)
	{
		for(spinum=0;spinum<2;spinum++) { Adbms6815_Daisy_Read_DmaEnd(spinum,dir,GC_TYPE,pad->u16Cv,READ_TH_Type);}								// th read end		C cast
	}
	else if(s_u16cnt == 80)
	{
		//TODO : loop BMS data 
		// meas : curr, pv, pn
		// cal cv, th, curr
		// cal soc, soh
		// bms status
		// uart tx
		// mvb tx
		// check det
		// relay contol
		// btms rs485 comm	
		// ext
	}
	else if(s_u16cnt == 100)
	{
		// SM Diagnosit Start
		
	}
	else if(s_u16cnt == 150)
	{
		
	}

	if(++s_u16cnt > 200){
		s_u16cnt = 0;
		if(++sadtype> (u8)MAX_AdcConv_Type){
			sadtype = 0;
		}
	}
}
#endif

