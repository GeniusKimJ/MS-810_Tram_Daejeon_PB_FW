void Adbms6815_Daisy_Read_DmaStart(eAdSpi_Type eAfe, eAdComDir_Type eComDir,eRegGroup_Type eRegGroup,u16 u16Cmd)
{
	SPI_HandleTypeDef *hspi = (eAfe == SPI1_Type) ? &hspi1 : &hspi2;
	u8	i 		= 0;
	u8	k 		= 0;
	u16	pec 	= 0;
	u16	len		= (u16)(4+(8*NSLV));

	g_u8Tx[eAfe][eRegGroup][0] = (u8)((u16Cmd >> 8) & 0xFF);
	g_u8Tx[eAfe][eRegGroup][1] = (u8)(u16Cmd & 0xFF);

	pec = Adbms6815_CmdPec15(&g_u8Tx[eAfe][eRegGroup][0], 2);
	g_u8Tx[eAfe][eRegGroup][2] = (u8)((pec >> 8) & 0xFF);
	g_u8Tx[eAfe][eRegGroup][3] = (u8)(pec & 0xFF);

	for(k = 0; i < NSLV; i++){
		for(k = 0; k < 8 ; k ++){
			g_u8Tx[eAfe][eRegGroup][4+k+(i*8)] = 0xFF;
		}
	}
	Adbms6815_Wakeup(eAfe,eComDir);
	Adbms6815_ChipSel(eAfe,eComDir, TRUE);
#if EN_DMA
	GPIO_DOut_TP1(TRUE);
	HAL_SPI_TransmitReceive_DMA(hspi, g_u8Tx[eAfe][eRegGroup], g_u8Rx[eAfe][eRegGroup],len);
	GPIO_DOut_TP1(FALSE);
#else
	HAL_SPI_TransmitReceive(hspi, g_u8Tx[eAfe][eRegGroup], g_u8Rx[eAfe][eRegGroup],len,5);
	Adbms6815_ChipSel(eAfe,eComDir, FALSE);
#endif

}

void Adbms6815_Daisy_Read_DmaEnd(eAdSpi_Type eAfe,eAdComDir_Type eComDir, eRegGroup_Type eRegGroup, 
													sAdbms6815 *pAd, eAdRead_Type eRdType, eAdRead_FuSa_Type eRdFusaType)
{
	u8	nreg 		= 0;
	u8	nslv		= 0;
	u8	stapos		= (eRegGroup * NGRP);
	u8	slvpos[NSLV] = {0,}; 
	u8	reg[NREG]	= {0,};
	u16	pec_rx		= 0;
	u16	pec_mk 		= 0;
	u16	cmdcnt 		= 0;
	//u16	dirpos		= 0;
	//float buf[3]	= {0.0f,};

#if EN_DMA
	Adbms6815_ChipSel(eAfe,eComDir, FALSE);
#endif

	for(nslv=0; nslv<NSLV; nslv++){
		slvpos[nslv] = Adbms6815_Get_AfePos(nslv);																				// get afe pos
	}

	for(nslv=0; nslv<NSLV; nslv++){
		pec_rx = ((u16)(g_u8Rx[eAfe][eRegGroup][10+(nslv*8)])<<8)+g_u8Rx[eAfe][eRegGroup][11+(nslv*8)];							// read pec
		cmdcnt = Adbms6815_CmdCnt(&pec_rx);																						// cmdcount
		pec_mk = Adbms6815_DatPec10(&g_u8Rx[eAfe][eRegGroup][4+ nslv*8], 6, TRUE);												// make pec
		
		if(pec_rx == pec_mk){																									// compare pec
			for(nreg=0; nreg<6; nreg++){
				reg[nreg] = g_u8Rx[eAfe][eRegGroup][4+(nslv*8)+nreg];
			}

			switch (eRdType) {
				case READ_CV_Type:                                    															// cell 3ea / 123 / 456 / 78				
					if(eRdFusaType == FUSA_CV_Type){
						pAd->u16Cv[eAfe][slvpos[nslv]][stapos + 0] =(u16)(float)((u16)(((u16)reg[0]) | ((u16)reg[1] << 8)) * 0.1f);
						pAd->u16Cv[eAfe][slvpos[nslv]][stapos + 1] = (u16)(float)((u16)(((u16)reg[2]) | ((u16)reg[3] << 8)) * 0.1f);
						if (stapos < 6) {
						  pAd->u16Cv[eAfe][slvpos[nslv]][stapos + 2] =(u16)(float)((u16)(((u16)reg[4]) | ((u16)reg[5] << 8)) * 0.1f);
						}
					}else if(eRdFusaType == FUSA_SV_Type){
						pAd->u16Sv[eAfe][slvpos[nslv]][stapos + 0] =(u16)(float)((u16)(((u16)reg[0]) | ((u16)reg[1] << 8)) * 0.1f);
						pAd->u16Sv[eAfe][slvpos[nslv]][stapos + 1] = (u16)(float)((u16)(((u16)reg[2]) | ((u16)reg[3] << 8)) * 0.1f);
						if (stapos < 6) {
						  pAd->u16Sv[eAfe][slvpos[nslv]][stapos + 2] =(u16)(float)((u16)(((u16)reg[4]) | ((u16)reg[5] << 8)) * 0.1f);
						}
					}else if(eRdFusaType == FUSA_OW_Type){
						pAd->u16Ow[eAfe][slvpos[nslv]][stapos + 0] =(u16)(float)((u16)(((u16)reg[0]) | ((u16)reg[1] << 8)) * 0.1f);
						pAd->u16Ow[eAfe][slvpos[nslv]][stapos + 1] = (u16)(float)((u16)(((u16)reg[2]) | ((u16)reg[3] << 8)) * 0.1f);
						if (stapos < 6) {
						  pAd->u16Ow[eAfe][slvpos[nslv]][stapos + 2] =(u16)(float)((u16)(((u16)reg[4]) | ((u16)reg[5] << 8)) * 0.1f);
						}
					}else if(eRdFusaType == FUSA_EV_Type){
						pAd->u16EvCv[eAfe][slvpos[nslv]][stapos + 0] =(u16)(float)((u16)(((u16)reg[0]) | ((u16)reg[1] << 8)) * 0.1f);
						pAd->u16EvCv[eAfe][slvpos[nslv]][stapos + 1] = (u16)(float)((u16)(((u16)reg[2]) | ((u16)reg[3] << 8)) * 0.1f);
						if (stapos < 6) {
						  pAd->u16EvCv[eAfe][slvpos[nslv]][stapos + 2] =(u16)(float)((u16)(((u16)reg[4]) | ((u16)reg[5] << 8)) * 0.1f);
						}
					}else if(eRdFusaType == FUSA_OD_Type){
						pAd->u16OdCv[eAfe][slvpos[nslv]][stapos + 0] =(u16)(float)((u16)(((u16)reg[0]) | ((u16)reg[1] << 8)) * 0.1f);
						pAd->u16OdCv[eAfe][slvpos[nslv]][stapos + 1] = (u16)(float)((u16)(((u16)reg[2]) | ((u16)reg[3] << 8)) * 0.1f);
						if (stapos < 6) {
						  pAd->u16OdCv[eAfe][slvpos[nslv]][stapos + 2] =(u16)(float)((u16)(((u16)reg[4]) | ((u16)reg[5] << 8)) * 0.1f);
						}
					}else if(eRdFusaType == FUSA_CV_AD1_Type){
						pAd->u16Ad1Cv[eAfe][slvpos[nslv]][stapos + 0] =(u16)(float)((u16)(((u16)reg[0]) | ((u16)reg[1] << 8)) * 0.1f);
						pAd->u16Ad1Cv[eAfe][slvpos[nslv]][stapos + 1] = (u16)(float)((u16)(((u16)reg[2]) | ((u16)reg[3] << 8)) * 0.1f);
						if (stapos < 6) {
						  pAd->u16Ad1Cv[eAfe][slvpos[nslv]][stapos + 2] =(u16)(float)((u16)(((u16)reg[4]) | ((u16)reg[5] << 8)) * 0.1f);
						}
					}else if(eRdFusaType == FUSA_CV_AD2_Type){
						pAd->u16Ad2Cv[eAfe][slvpos[nslv]][stapos + 0] =(u16)(float)((u16)(((u16)reg[0]) | ((u16)reg[1] << 8)) * 0.1f);
						pAd->u16Ad2Cv[eAfe][slvpos[nslv]][stapos + 1] = (u16)(float)((u16)(((u16)reg[2]) | ((u16)reg[3] << 8)) * 0.1f);
						if (stapos < 6) {
						  pAd->u16Ad2Cv[eAfe][slvpos[nslv]][stapos + 2] =(u16)(float)((u16)(((u16)reg[4]) | ((u16)reg[5] << 8)) * 0.1f);
						}
					}break;
					
				case READ_TH_Type:
				    if (eRegGroup == GA_TYPE) {
				      	pAd->u16Vref2[eAfe][slvpos[nslv]] = ((u16)reg[1] << 8) | reg[0];										// Vref
						
						pAd->u16ThAdc[eAfe][slvpos[nslv]][0] = Adbms6815_Scale(READ_TH_Type,reg[3],reg[2]);
						pAd->s16Th[eAfe][slvpos[nslv]][0] = (s16)TempAmbient(pAd->u16ThAdc[eAfe][slvpos[nslv]][0]);

						pAd->u16ThAdc[eAfe][slvpos[nslv]][1] = Adbms6815_Scale(READ_TH_Type,reg[5],reg[4]);
						pAd->s16Th[eAfe][slvpos[nslv]][1] = (s16)TempAmbient(pAd->u16ThAdc[eAfe][slvpos[nslv]][1]);
				    }else if (eRegGroup == GB_TYPE) {
						pAd->u16ThAdc[eAfe][slvpos[nslv]][2] = Adbms6815_Scale(READ_TH_Type,reg[1],reg[0]);
						pAd->s16Th[eAfe][slvpos[nslv]][2] = (s16)TempAmbient(pAd->u16ThAdc[eAfe][slvpos[nslv]][2]);
					}else if (eRegGroup == GC_TYPE) {
						pAd->u16ThAdc[eAfe][slvpos[nslv]][3] = Adbms6815_Scale(READ_TH_Type,reg[1],reg[0]);
						pAd->s16Th[eAfe][slvpos[nslv]][3] = (s16)TempAmbient(pAd->u16ThAdc[eAfe][slvpos[nslv]][3]);

						pAd->u16Vref3[eAfe][slvpos[nslv]] = pAd->u16Vref2[eAfe][slvpos[nslv]] = ((u16)reg[5] << 8) | reg[4];    // Vref3
				    }break;

				case READ_ST_Type:
				    // TODO: status
				    break;

				default:
				    break;
			}
		}else{
			//TODO : All 0xff status (open line, ic err, noise)
			switch (eRdType) {
				case READ_CV_Type:			
					if(++pAd->u8ReadFailCheck[READ_CV_Type][slvpos[nslv]]>=0xFF) {
						pAd->u8ReadFailCheck[READ_CV_Type][slvpos[nslv]]=0;
					}
					pAd->u16Cv[eAfe][slvpos[nslv]][stapos + 0] =0;
					pAd->u16Cv[eAfe][slvpos[nslv]][stapos + 1] = 0;
				    if (stapos < 6) {
				      pAd->u16Cv[eAfe][slvpos[nslv]][stapos + 2] = 0;
				    }break;
				case READ_TH_Type:
					if(++pAd->u8ReadFailCheck[READ_TH_Type][slvpos[nslv]]>=0xFF) {
						pAd->u8ReadFailCheck[READ_TH_Type][slvpos[nslv]]=0;
					}
					if (eRegGroup != GA_TYPE) {
						pAd->s16Th[eAfe][slvpos[nslv]][stapos + 0U] = 0;														// T3 T6
					} else {
						pAd->u16Vref2[eAfe][slvpos[nslv]] = 0;																	// Vreg2
					}

					pAd->s16Th[eAfe][slvpos[nslv]][stapos + 1U] = 0;			   												// T1 T4 T7
					if (eRegGroup != GC_TYPE) {
						pAd->s16Th[eAfe][slvpos[nslv]][stapos + 2U] = 0;
					} else {
						pAd->u16Vref3[eAfe][slvpos[nslv]] = 0;																	// Vref3
					}break;
				case READ_ST_Type:
					if(++pAd->u8ReadFailCheck[READ_ST_Type][slvpos[nslv]] >=0xFF) {
						pAd->u8ReadFailCheck[READ_ST_Type][slvpos[nslv]]=0;
					}
					break;
				default:
					break;
			}
		}
	}
}



void Adbms6815_Daisy_SM_Poll_Read(eAdSpi_Type eAfe, eAdComDir_Type eComDir,eRegGroup_Type eRegGroup,u16 u16Cmd, sSM_Task *pSm)
{
	SPI_HandleTypeDef *hspi = (eAfe == SPI1_Type) ? &hspi1 : &hspi2;
	static u8 reg[NSLV][6]	= {{0,},};
	u8	i 				= 0;
	u8	k 				= 0;
	u8	nslv			= 0;
	u8	nreg			= 0;
	u8	errcnt			= 0;
	
	u16	pec 			= 0;
	u16	len				= (u16)(4+(8*NSLV));
	u16	pec_rx			= 0;
	u16	pec_mk			= 0;
	u16	cmdcnt			= 0;


	g_u8Tx[eAfe][eRegGroup][0] = (u8)((u16Cmd >> 8) & 0xFF);
	g_u8Tx[eAfe][eRegGroup][1] = (u8)(u16Cmd & 0xFF);

	pec = Adbms6815_CmdPec15(&g_u8TxData[0], 2);
	g_u8Tx[eAfe][eRegGroup][2] = (u8)((pec >> 8) & 0xFF);
	g_u8Tx[eAfe][eRegGroup][3] = (u8)(pec & 0xFF);

	for(k = 0; k < NSLV; k++){
		for(i = 0; i < 8 ; i ++){
			g_u8Tx[eAfe][eRegGroup][4+i+(k*8)] = 0xFF;
		}
	}

	Adbms6815_ChipSel(eAfe,eComDir, TRUE);
	HAL_SPI_TransmitReceive(hspi,g_u8Tx[eAfe][eRegGroup],g_u8Rx[eAfe][eRegGroup],len,5);
	Adbms6815_ChipSel(eAfe,eComDir, FALSE);
    
	for(; nslv<NSLV; nslv++){		
		pec_rx = ((u16)(g_u8Rx[eAfe][eRegGroup][10+(nslv*8)])<<8) + g_u8Rx[eAfe][eRegGroup][11+(nslv*8)];						// check pec
		cmdcnt = Adbms6815_CmdCnt(&pec_rx);
		pec_mk = Adbms6815_DatPec10(&g_u8Rx[eAfe][eRegGroup][4+(nslv*8)],6,TRUE);
	
		if(pec_rx == pec_mk) {																									// comp pec
			for(nreg=0; nreg<6; nreg++){
				reg[nslv][nreg] = g_u8Rx[eAfe][eRegGroup][4+(nslv*8)+nreg];
			}
		}
#if 0
		switch(pSm->eSMNum){
			case SM1_Type:	
				if((reg[nslv][1 & MUXFAIL) == 1){
					errcnt++;
				}break;
			case SM2_Type:
				g_sAd6815Data.u16Vref2[nslv] = (reg[nslv][0]|reg[nslv][1]<<8);													// Check ref2 RefV
				if((g_sAd6815Data.u16Vref2<2900) || (g_sAd6815Data.u16Vref2>3100)){															
					errcnt++;													
				}break;
			case SM7_Type:
				if(sts == 0){
					g_sAd6815Data.u16Vad[nslv] = (reg[nslv][4]|reg[nslv][5]<<8);												// VREG Analog
					sts = 1;
				}else{
					g_sAd6815Data.u16Vdd[nslv] = (reg[nslv][0]|reg[nslv][1]<<8);												// VREG Digital
					g_sAd6815Data.u16VadDiff[nslv] = LABS_U16(g_sAd6815Data.u16Vad[nslv] - g_sAd6815Data.u16Vdd[nslv]);
					if(g_sAd6815Data.u16VadDiff[nslv]>8){ 																		// >8mV
						errcnt++;
					}break;
					sts = 0;
				}
				if(u16Cmd != RDSTSB){ 
					return; 
				}break;
			case SM9_Type:	
				g_sAd6815Data.u16Adol1 = (reg[nslv][2]|reg[nslv][3]<<8);														// adc1 cv7
				g_sAd6815Data.u16Adol2 = (reg[nslv][4]|reg[nslv][5]<<8);														// adc2 cv7
				g_sAd6815Data.u16AdolDiff[nslv] = LABS_U16(g_sAd6815Data.u16Adol1 - g_sAd6815Data.u16Adol2);
				if(g_sAd6815Data.u16AdolDiff>8){																				//>8mV
					errcnt++;
				}break;
			case SM12_Type:	break;
			case SM15_Type:	break;
			case SM17_Type:	
				for(nscv=0; nscv<NSCV; nscv++){
				   float fsv = (float)g_sAd6815Data.u16Sv[nslv][nscv];
				   float fcv = (float)g_sAd6815Data.u16Cv[nslv][nscv];
			   
				   if(fcv > 10.0f){ 										   													// �븻 ������ 0�� �ƴϸ�
					   float fRatio = (float)(fsv / fcv);
					   if((fRatio < 0.1f) || (fRatio > 0.9f)){
						   errcnt++;										   													// Ratio �ʰ� ����
					   }
				   }
				}break;
			case SM22_Type:																										// READ Fail
				if((reg[nslv][1] & REDFAIL) == 1){
					errcnt++;
				}
				if((reg[nslv][1] & OSCCHK) == 1){																				// Clock Check	
					errcnt++;
				}break;
			case SM23_Type:	break;																								// Clock Check 22���� ���� üũ
			case SM24_Type:	break;																								// GPIO�� �������� �ƴϹǷ� ���?�Ұ�.
			case SM26_Type:	break;																								// PEC�� ������ �ۼ��Ÿ��� �˻��ϹǷ� ����
			case SM29_Type:	break;																								// GPIO Open wire check
			case SM31_Type:																										// Vref3 5V ���� ���޵Ǵ��� Ȯ��.
				g_sAd6815Data.u16Vref3[nslv] = (u16)((reg[5] <<8)|reg[4]);		
				if((g_sAd6815Data.u16Vref3[nslv] < 4800) && g_sAd6815Data.u16Vref3[nslv]> 5200){
					errcnt++;
				}break;			

			case SM34_Type:																										// Charge Pump Fault ���� �߻� �ؼ� ���� ��������C Ȯ��
				if(sts == 0){																									// Charge Pump Fault ���� �߻��Ͽ� �÷��� 1���� Ȯ��
					if((reg[nslv][1] & CPCHK) == 1){
						//����
					}else{
						errcnt++;
					}sts = 1;					
				}else{
					if((reg[nslv][1] & CPCHK) == 0){																			// Charge Pump �÷��� ������ �÷��� 0���� Ȯ��.
						//����
					}else{
						errcnt++;
					}sts = 0;
				}break;
				
			case SM38_Type:	errcnt++;	break;
			case SM41_Type:
				if(sts == 0){
					if((reg[nslv][nreg] & FLAGD5) != 1){																		// �÷��� Ȯ���ؼ� 1�̸� ����
						errcnt++;
					}sts = 1;
				}else{
					if((reg[nslv][nreg] & FLAGD5) != 1){																		// Ŭ������ �÷��� Ȯ���ؼ� 0�̸� ����
						errcnt++; 
					}sts = 0;
				}break;
			case SM42_Type:	errcnt++;	break;
			case SM45_Type:	errcnt++;	break;
			case SM50_Type:	errcnt++;	break;
			default: break;
		}
		
#endif
		pSm->u16DtcCount[eAfe][nslv][pSm->eSMNum] += errcnt;
	}

	if(pSm->u16DtcCount[eAfe][nslv][pSm->eSMNum] >=0xFFFF){
		pSm->u16DtcCount[eAfe][nslv][pSm->eSMNum] = 0xFFFF;
	}
	
	if(pSm->u16DtcCount[eAfe][nslv][pSm->eSMNum]> MAX_DTC_COUNT){
		//todo : err proc. . .
	}
}




void Adbms6815_WrCfgA(eAdSpi_Type eAfe,eAdComDir_Type eComDir, u8 EnPs,u8 FlagD,u8 Soak, u8 Owrn)
{	
	for(u8 nslv = 0;nslv<NSLV;nslv++) {
		g_u8Adbms6815_CfgrA[eAfe][nslv][0] = (EnPs|REFON);																			// cfga 1000 0000b
		g_u8Adbms6815_CfgrA[eAfe][nslv][1] = FlagD;
		if(Soak == 1) {
			g_u8Adbms6815_CfgrA[eAfe][nslv][2] = (Soak|Owrn|OWC1|OWC2); 
		}
		g_u8Adbms6815_CfgrA[eAfe][nslv][3] = 0x27;
		//g_u8Adbms6815_CfgrA[eAfe][nslv][3] = (u8)NSTH;
	}
	Adbms6815_Daisy_CfgWrite(eAfe,eComDir,WRCFGA,g_u8Adbms6815_CfgrA);

}

void Adbms6815_WrCfgB(eAdSpi_Type eAfe,eAdComDir_Type eComDir)
{	
	for(u8 nslv = 0;nslv<NSLV;nslv++) {																							// cfgb VOV, VUV default 0xF0
		g_u8Adbms6815_CfgrB[eAfe][nslv][1] = 0x00;
		g_u8Adbms6815_CfgrB[eAfe][nslv][2] = 0xF0;
		g_u8Adbms6815_CfgrB[eAfe][nslv][3] = 0xFF;
	}
	Adbms6815_Daisy_CfgWrite(eAfe,eComDir,WRCFGB,g_u8Adbms6815_CfgrB);
}

void Adbms6815_Daisy_CfgWrite(eAdSpi_Type eAfe, eAdComDir_Type eComDir,u16 u16Cmd,u8 u8Cfgr[][NSLV][6])
{
	SPI_HandleTypeDef *hspi = (eAfe == SPI1_Type) ? &hspi1 : &hspi2;
	u8	tx[(NCMD+NPEC)+((NREG+NPEC)*NSLV)]			= {0,};
	u8	rx[(NCMD+NPEC)+((NREG+NPEC)*NSLV)]			= {0,};

	u8	i 				= 0;
	u8	k 				= 0;
	u16	pec 			= 0;
	tx[0] = (u8)((u16Cmd>>8) & 0xFF);
	tx[1] = (u8)(u16Cmd & 0xFF);

	pec = Adbms6815_CmdPec15(&tx[0], 2);
	tx[2] = (u8)((pec >> 8) & 0xFF);
	tx[3] = (u8)(pec & 0xFF);

	pec = Adbms6815_DatPec10(u8Cfgr[eAfe][k],6,FALSE);
	for(k=0;k<NSLV;k++)
	{
		for(i=0;i<6;i++){
			tx[4+i+(k*8)] = u8Cfgr[eAfe][k][i];
		}
		
		tx[10+(8*k)] = (u8)((pec >> 8) & 0xFF);
		tx[11+(8*k)] = (u8)(pec & 0xFF);
	}
	Adbms6815_Wakeup(eAfe,eComDir);
	Adbms6815_ChipSel(eAfe,eComDir, TRUE);
	HAL_SPI_TransmitReceive(hspi,tx,rx,sizeof(tx),20);
	Adbms6815_ChipSel(eAfe,eComDir, FALSE);	
}

/* CONFIG BAL BEGIN**************************************************************************************************************************/
void Adbms6815_WrCfgBal(eAdSpi_Type eAfe, eAdComDir_Type eComDir,u16 u16ManualbalFlag[], BOOL bManualBal)
{
	u8 	i				= 0;
	u8	nslv			= 0;	// daisy buff size (4+8) * 36
	u8	slvpos[NSLV]	= {0,};

	for(i = 0; i < NSLV; i ++){														
		slvpos[i] = Adbms6815_Get_AfePos(i);																					// read buff position 
	}

	for(nslv = 0; ((NSLV-1)-nslv) > 0;nslv++) {																					// mask bal flag
		g_u8Adbms6815_CfgrB[eAfe][slvpos[nslv]][4] = 0;
		g_u8Adbms6815_CfgrB[eAfe][slvpos[nslv]][5] = g_sAd6815Data.u8CvBal[eAfe][nslv] & 0xff;
	}
	
	Adbms6815_Daisy_CfgWrite(eAfe,eComDir,WRCFGB,g_u8Adbms6815_CfgrB);
}

void Adbms8615_WrcfgBal_EvenOdd(eAdSpi_Type eAfe, eAdComDir_Type eComDir, u8 u8EvenOdd)
{
	u8 u8balbuf[NAFE][NSLV][6]	= {{{0,},},};
	u8 fill = (u8EvenOdd == 1) ? 0xAA : 0x55;
	memset(&u8balbuf, fill, sizeof(u8balbuf));
	Adbms6815_Daisy_CfgWrite(eAfe,eComDir,WRCFGB,u8balbuf);
}


/* CONFIG BAL END****************************************************************************************************************************/



//chip select direction
void Adbms6815_Cal_AfePos(eAdComDir_Type eComDir,eAdRw_Type eWriteRead)
{
	u8 i = 0;
	if(eWriteRead == WR_WR_Type){ 																								// Write
		if(eComDir == ComDir_A_Type){					
			for(i = 0;i<NSLV;i++){
				g_u8AfePos[i] = i;																								// AFE1 -> Write(Near(0) -> Far(35))
			}	
		}else if(eComDir == ComDir_B_Type){			
			for(i = 0;i<NSLV;i++){
				g_u8AfePos[i] = ((NSLV-1)-i); 																					// AFE1 -> Write(Far(35) -> Near(0))
			}
		}
	}else{																														// Read
		if(eComDir == ComDir_A_Type){					
			for(i = 0;i<NSLV;i++){
				g_u8AfePos[i] = ((NSLV-1)-i); 																					// AFE2 -> Read(Near(0) -> Far(35))
			}
		}else if(eComDir == ComDir_B_Type){
			for(i = 0;i<NSLV;i++){
				g_u8AfePos[i] = i;																								// AFE2 -> Read(Far(35) -> Near(0))
			}
		}
	}	
}

u8 Adbms6815_Get_AfePos(u8 u8AfePos)
{
	if(u8AfePos >= NSLV) { u8AfePos = 0; }
	return g_u8AfePos[u8AfePos];
}



void Adbms6815_ManualBalance(eAdComDir_Type eComDir)
{
#if 0
	u32 i = 0;

	if(   ((g_sAd6815Data->u8ManualTestCmdPos >> ManualTestCmd_Balancing_Type) & 0x01) == TRUE ){
		// Cell Balancing
		if(   ((pstCanReq->u8ManualTestCmdValue >> ManualTestCmd_Balancing_Type) & 0x01) == TRUE  ){
			for(i = 0; i < g_stBmsStatus.u8MonIcCount; i ++){
				g_sAd6815Data.u16fBal[i] = 0xFFFF;
			}
		}else{
			for(i = 0; i < g_stBmsStatus.u8MonIcCount; i ++){
				g_sAd6815Data.u16fBal[i] = 0;
			}
		}
	}
#endif
}

u16 Adbms6815_CmdCnt(u16* pu16ReadPec)
{
	u16 u16CmdCounter = 0;
	u16 u16Temp = 0;

	u16CmdCounter = (*pu16ReadPec >>10) & 0x3F;
	u16Temp = (*pu16ReadPec) & 0x3FF;

	(*pu16ReadPec) = u16Temp;
	return u16CmdCounter;
}


void Adbms6815_Init(void)
{		
	//HAL_DMA_RegisterCallback(&hspi1, HAL_DMA_XFER_CPLT_CB_ID, Adbms6815_Callback_DMAReComplete());							//HAL_DMA_XFER_CPLT_CB_ID  DMA Send Check Index
	g_sAd6815Data.eAfe = SPI1_Type;
	g_sAd6815Data.eComDir = ComDir_A_Type;

	Adbms6815_Init_Pec15_Table();
	Adbms6815_Init_Pec10_Table();
	g_sAd6815Data.bAdbmsInitDone = TRUE; 
}


void Adbms6815_NorCell_Proc(void)
{
	sAdbms6815 		*pad		= &g_sAd6815Data;
	u16 cmd[3]					= {RDCVA,RDCVB,RDCVC}; 
	
	if(g_sSysTick.bAdbmsProc_Cv == TRUE){
		g_sSysTick.bAdbmsProc_Cv = FALSE;
		tick_s = HAL_GetTick();					// debug start tick
		g_sAd6815Data.eAdCvRead[pad->eAfe] = AdReadProc_Start_Type;
		pad->eRegGrp = 0;
		
		//Adbms6815_Cmd_Write(pad->eAfe,pad->eComDir,SRST);																			// afe reset																																																																																																																																																																																																																																															
		//Adbms6815_Cmd_Write(pad->eAfe,pad->eComDir,CLRCELL);																	   		// 1. clear reg
		Adbms6815_WrCfgA(pad->eAfe,pad->eComDir,0,0,0,0);																		   		// cfg a
		Adbms6815_WrCfgB(pad->eAfe,pad->eComDir);																				  		 // cfg b
		Adbms6815_Cmd_Write(pad->eAfe,pad->eComDir,ADCV);

	}
	if(g_sAd6815Data.eAdCvRead[pad->eAfe] == AdReadProc_Start_Type){
		g_sAd6815Data.eAdCvRead[pad->eAfe] = AdReadProc_StartDma_Type;
		Adbms6815_Daisy_Read_DmaStart(pad->eAfe,pad->eComDir,pad->eRegGrp,cmd[pad->eRegGrp]);
	}
	
	if(g_sAd6815Data.eAdCvRead[pad->eAfe] == AdReadProc_Read_Type){
		Adbms6815_Daisy_Read_DmaEnd(pad->eAfe,pad->eComDir,pad->eRegGrp, pad, READ_CV_Type,FUSA_CV_Type);	
		if(++pad->eRegGrp>=MAX_GRP_TYPE){
			tick_e = HAL_GetTick();				// debug end tick
			tick_d = labs(tick_e - tick_s);		// debug time taken
 			g_sAd6815Data.eAdCvRead[pad->eAfe] = AdReadProc_NoOp_Type;
		}else{		
			g_sAd6815Data.eAdCvRead[pad->eAfe] = AdReadProc_Start_Type;
		}
	}
}

void Adbms6815_NorTh_Proc(void)
{
	sAdbms6815 		*pad		= &g_sAd6815Data;
	u16 cmd[3]					= {RDAXA,RDAXB,RDAXC}; 

	if(g_sSysTick.bAdbmsProc_Th == TRUE){
		g_sSysTick.bAdbmsProc_Th = FALSE;
		g_sAd6815Data.eAdThRead[pad->eAfe] = AdReadProc_Start_Type;
		pad->eRegGrp = 0;
		Adbms6815_Cmd_Write(pad->eAfe,pad->eComDir,ADAX);
	}

	if(g_sAd6815Data.eAdThRead[pad->eAfe] == AdReadProc_Start_Type){
		g_sAd6815Data.eAdThRead[pad->eAfe] = AdReadProc_StartDma_Type;
		Adbms6815_Daisy_Read_DmaStart(pad->eAfe,pad->eComDir,pad->eRegGrp,cmd[pad->eRegGrp]);
	}

	if(g_sAd6815Data.eAdThRead[pad->eAfe] == AdReadProc_Read_Type){
		Adbms6815_Daisy_Read_DmaEnd(pad->eAfe,pad->eComDir,pad->eRegGrp, pad, READ_TH_Type,FUSA_CV_Type);
		if(++pad->eRegGrp>=MAX_GRP_TYPE){
			g_sAd6815Data.eAdThRead[pad->eAfe] = AdReadProc_NoOp_Type;
		}else{
			g_sAd6815Data.eAdThRead[pad->eAfe] = AdReadProc_Start_Type;
		}
	}
}


#if 0
void Adbms6815_Proc(void)
{
	sAdbms6815 		*pad	= &g_sAd6815Data;
	eRegGroup_Type 	grp		= pad->eRegGrp;
