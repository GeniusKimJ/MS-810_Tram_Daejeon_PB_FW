		for(spinum=0;spinum<2;spinum++) {Adbms6815_Cmd_Write(spinum,dir,CLRCELL);}																		// 1. clear reg
		for(spinum=0;spinum<2;spinum++) {Adbms6815_WrCfgA(spinum,dir,0,0,0,0);}																			// cfg a
		for(spinum=0;spinum<2;spinum++) {Adbms6815_WrCfgB(spinum,dir);}																					// cfg b
