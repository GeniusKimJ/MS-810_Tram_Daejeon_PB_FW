/* Includes ---------------------------------------------------------------------------------------*/
#include <ms_mvb.h>
#include "ms_timer.h"

/* Private define ---------------------------------------------------------------------------------*/
/* Private macro ----------------------------------------------------------------------------------*/
/* Private typedef --------------------------------------------------------------------------------*/

#define MVB_HEADER_MVB_DEV  0xAB
#define MVB_HEADER_DEV_MVB  0xAA
#define MVB_ENDER           0xEE

#define MVB_PORT_COUNT_3    3
#define MVB_TYPE_SOURCE     0x08
#define MVB_TYPE_SINK       0x04


#define MVB_CMD_IDX     1
#define MVB_LEN_IDX     2
#define MVB_DATA_IDX    3

#define MVB_HEADER_LEN  1
#define MVB_LEN_LEN     1
#define MVB_CRC_LEN     2
#define MVB_ENDER_LEN   1
#define MVB_MIN_LEN     ( MVB_HEADER_LEN + MVB_LEN_LEN + MVB_CRC_LEN + MVB_ENDER_LEN )
    
/* Private variables ------------------------------------------------------------------------------*/
extern UART_HandleTypeDef huart2;
sMvbData g_sMvbData = {0};


/* Private function prototypes --------------------------------------------------------------------*/
/* Private functions ------------------------------------------------------------------------------*/
#if 1
u16 MVB_Crc16(const u8 *buf, int len)
{
	/* CRC16 implementation acording to CCITT standards */
	static const u16 crc16tab[256]= { 
		0x0000,0x1021,0x2042,0x3063,0x4084,0x50a5,0x60c6,0x70e7, 
		0x8108,0x9129,0xa14a,0xb16b,0xc18c,0xd1ad,0xe1ce,0xf1ef, 
