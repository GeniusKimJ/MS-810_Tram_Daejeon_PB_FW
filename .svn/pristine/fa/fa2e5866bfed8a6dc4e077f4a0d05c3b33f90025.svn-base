void Adbms6815_Daisy_Read_DmaStart(eAdAfe_Type eAfe, eAdComDir_Type eComDir,eRegGroup_Type eRegGroup,u16 u16Cmd)
{
	SPI_HandleTypeDef *hspi = (eAfe == AFE1_Type) ? &hspi1 : &hspi2;
	u8	i 		= 0;
	u8	k 		= 0;
	u16	pec 	= 0;
	u16	len	= (u16)(4+(8*NSLV));

	g_u8Tx[eAfe][eRegGroup][0] = (u8)((u16Cmd >> 8) & 0xFF);
	g_u8Tx[eAfe][eRegGroup][1] = (u8)(u16Cmd & 0xFF);

	pec = Adbms6815_CmdPec15(&g_u8TxData[0], 2);
	g_u8Tx[eAfe][eRegGroup][2] = (u8)((pec >> 8) & 0xFF);
	g_u8Tx[eAfe][eRegGroup][3] = (u8)(pec & 0xFF);

	for(k = 0; k < NSLV; k++){
		for(i = 0; i < 8 ; i ++){
			g_u8Tx[eAfe][eRegGroup][4+i+(k*8)] = 0xFF;
		}
	}

	Adbms6815_ChipSel(eAfe,eComDir, TRUE);
    Delay_us(2);
	HAL_SPI_TransmitReceive_DMA(hspi, g_u8Tx[eAfe][eRegGroup], g_u8Rx[eAfe][eRegGroup],len);
}

void Adbms6815_Daisy_SM_Poll_Read(eAdAfe_Type eAfe, eAdComDir_Type eComDir,eRegGroup_Type eRegGroup,u16 u16Cmd, sSM_Task *pSm)
{
	SPI_HandleTypeDef *hspi = (eAfe == AFE1_Type) ? &hspi1 : &hspi2;
	static u8 reg[NSLV][6]	= {{0,},};
	u8	i 				= 0;
	u8	k 				= 0;
	u8	nslv			= 0;
	u8	nreg			= 0;
	u8	errcnt			= 0;
	
	u16	pec 			= 0;
	u16	len				= (u16)(4+(8*NSLV));
	u16	pec_rx			= 0;
	u16	pec_mk			= 0;
	u16	cmdcnt			= 0;

	g_sAd6815Data.bDmaReadDone = FALSE;
	g_u8Tx[eAfe][eRegGroup][0] = (u8)((u16Cmd >> 8) & 0xFF);
	g_u8Tx[eAfe][eRegGroup][1] = (u8)(u16Cmd & 0xFF);

	pec = Adbms6815_CmdPec15(&g_u8TxData[0], 2);
	g_u8Tx[eAfe][eRegGroup][2] = (u8)((pec >> 8) & 0xFF);
	g_u8Tx[eAfe][eRegGroup][3] = (u8)(pec & 0xFF);

	for(k = 0; k < NSLV; k++){
		for(i = 0; i < 8 ; i ++){
			g_u8Tx[eAfe][eRegGroup][4+i+(k*8)] = 0xFF;
		}
	}

	Adbms6815_ChipSel(eAfe,eComDir, TRUE);
    Delay_us(2);
	HAL_SPI_TransmitReceive(hspi,g_u8Tx[eAfe][eRegGroup],g_u8Rx[eAfe][eRegGroup],len,5);
	Adbms6815_ChipSel(eAfe,eComDir, TRUE);

	for(; nslv<NSLV; nslv++){		
		pec_rx = ((u16)(g_u8Rx[eAfe][eRegGroup][10+(nslv*8)])<<8) + g_u8Rx[eAfe][eRegGroup][11+(nslv*8)];					// check pec
		cmdcnt = Adbms6815_CmdCnt(&pec_rx);
		pec_mk = Adbms6815_DatPec10(&g_u8Rx[eAfe][eRegGroup][4+(nslv*8)],6,TRUE);
	
		if(pec_rx == pec_mk) {																					// comp pec
			for(nreg=0; nreg<6; nreg++){
				reg[nslv][nreg] = g_u8Rx[eAfe][eRegGroup][4+(nslv*8)+nreg];
			}
		}
#if 0
		switch(pSm->eSMNum){
			case SM1_Type:	
				if((reg[nslv][1 & MUXFAIL) == 1){
					errcnt++;
				}break;
			case SM2_Type:
				g_sAd6815Data.u16Vref2[nslv] = (reg[nslv][0]|reg[nslv][1]<<8);									// Check ref2 RefV
				if((g_sAd6815Data.u16Vref2<2900) || (g_sAd6815Data.u16Vref2>3100)){															
					errcnt++;													
				}break;
			case SM7_Type:
				if(sts == 0){
					g_sAd6815Data.u16Vad[nslv] = (reg[nslv][4]|reg[nslv][5]<<8);								// VREG Analog
					sts = 1;
				}else{
					g_sAd6815Data.u16Vdd[nslv] = (reg[nslv][0]|reg[nslv][1]<<8);								// VREG Digital
					g_sAd6815Data.u16VadDiff[nslv] = LABS_U16(g_sAd6815Data.u16Vad[nslv] - g_sAd6815Data.u16Vdd[nslv]);
					if(g_sAd6815Data.u16VadDiff[nslv]>8){ 																	// >8mV
						errcnt++;
					}break;
					sts = 0;
				}
				if(u16Cmd != RDSTSB){ 
					return; 
				}break;
			case SM9_Type:	
				g_sAd6815Data.u16Adol1 = (reg[nslv][2]|reg[nslv][3]<<8);										// adc1 cv7
				g_sAd6815Data.u16Adol2 = (reg[nslv][4]|reg[nslv][5]<<8);										// adc2 cv7
				g_sAd6815Data.u16AdolDiff[nslv] = LABS_U16(g_sAd6815Data.u16Adol1 - g_sAd6815Data.u16Adol2);
				if(g_sAd6815Data.u16AdolDiff>8){																//>8mV
					errcnt++;
				}break;
			case SM12_Type:	break;
			case SM15_Type:	break;
			case SM17_Type:	
				for(nscv=0; nscv<NSCV; nscv++){
				   float fsv = (float)g_sAd6815Data.u16Sv[nslv][nscv];
				   float fcv = (float)g_sAd6815Data.u16Cv[nslv][nscv];
			   
				   if(fcv > 10.0f){ 										   									// �븻 ������ 0�� �ƴϸ�
					   float fRatio = (float)(fsv / fcv);
					   if((fRatio < 0.1f) || (fRatio > 0.9f)){
						   errcnt++;										   									// Ratio �ʰ� ����
					   }
				   }
				}break;
			case SM22_Type:																						// READ Fail
				if((reg[nslv][1] & REDFAIL) == 1){
					errcnt++;
				}
				if((reg[nslv][1] & OSCCHK) == 1){																// Clock Check	
					errcnt++;
				}break;
			case SM23_Type:	break;																				// Clock Check 22���� ���� üũ
			case SM24_Type:	break;																				// GPIO�� �������� �ƴϹǷ� ���?�Ұ�.
			case SM26_Type:	break;																				// PEC�� ������ �ۼ��Ÿ��� �˻��ϹǷ� ����
			case SM29_Type:	break;																				// GPIO Open wire check
			case SM31_Type:																						// Vref3 5V ���� ���޵Ǵ��� Ȯ��.
				g_sAd6815Data.u16Vref3[nslv] = (u16)((reg[5] <<8)|reg[4]);		
				if((g_sAd6815Data.u16Vref3[nslv] < 4800) && g_sAd6815Data.u16Vref3[nslv]> 5200){
					errcnt++;
				}break;			

			case SM34_Type:																						// Charge Pump Fault ���� �߻� �ؼ� ���� ��������C Ȯ��
				if(sts == 0){																					// Charge Pump Fault ���� �߻��Ͽ� �÷��� 1���� Ȯ��
					if((reg[nslv][1] & CPCHK) == 1){
						//����
					}else{
						errcnt++;
					}sts = 1;					
				}else{
					if((reg[nslv][1] & CPCHK) == 0){															// Charge Pump �÷��� ������ �÷��� 0���� Ȯ��.
						//����
					}else{
						errcnt++;
					}sts = 0;
				}break;
				
			case SM38_Type:	errcnt++;	break;
			case SM41_Type:
				if(sts == 0){
					if((reg[nslv][nreg] & FLAGD5) != 1){														// �÷��� Ȯ���ؼ� 1�̸� ����
						errcnt++;
					}sts = 1;
				}else{
					if((reg[nslv][nreg] & FLAGD5) != 1){														// Ŭ������ �÷��� Ȯ���ؼ� 0�̸� ����
						errcnt++; 
					}sts = 0;
				}break;
			case SM42_Type:	errcnt++;	break;
			case SM45_Type:	errcnt++;	break;
			case SM50_Type:	errcnt++;	break;
			default: break;
		}
		
#endif
		pSm->u16DtcCount[eAfe][nslv][pSm->eSMNum] += errcnt;
	}

	if(pSm->u16DtcCount[eAfe][nslv][pSm->eSMNum] >=0xFFFF){
		pSm->u16DtcCount[eAfe][nslv][pSm->eSMNum] = 0xFFFF;
	}
	
	if(pSm->u16DtcCount[eAfe][nslv][pSm->eSMNum]> MAX_DTC_COUNT){
		//todo : err proc. . .
	}
}


void Adbms6815_Daisy_CfgWrite(eAdAfe_Type eAfe, eAdComDir_Type eComDir,u16 u16Cmd,u8 u8Cfgr[][NSLV][6])
{
	SPI_HandleTypeDef *hspi = (eAfe == AFE1_Type) ? &hspi1 : &hspi2;
	u8	tx[4+(8*NSLV)]	= {0,};
	u8	i 				= 0;
	u8	k 				= 0;
	u16	pec 			= 0;
	u16	len	= (u16)((NCMD+NPEC)+((NREG+NPEC)*NSLV));	//cmd2+pec2+((reg6+pec2) x slave36)) = CMD[4] +DAT[288]	
	tx[0] = (u8)((u16Cmd>>8) & 0xFF);
	tx[1] = (u8)(u16Cmd & 0xFF);

	pec = Adbms6815_CmdPec15(tx, 2);
	tx[2] = (u8)((pec >> 8) & 0xFF);
	tx[3] = (u8)(pec & 0xFF);

	for(k=0;k<NSLV;k++){
		pec = Adbms6815_DatPec10(&u8Cfgr[eAfe][k][2+(6*k)], 6, FALSE);
		for(i=0;i<6;i++)
			tx[4+i+(k*8)] = u8Cfgr[eAfe][k][i];
		
		tx[10+(8*k)] = (u8)((pec >> 8) & 0xFF);
		tx[11+(8*k)] = (u8)(pec & 0xFF);
	}
	
	Adbms6815_ChipSel(eAfe,eComDir, TRUE);
    Delay_us(2);
	HAL_SPI_Transmit(hspi, tx, len,5);
	Delay_us(2);
	Adbms6815_ChipSel(eAfe,eComDir, FALSE);
}


void Adbms6815_WrCfgA(eAdAfe_Type eAfe,eAdComDir_Type eComDir, u8 EnPs,u8 FlagD,u8 Soak, u8 Owrn)
{	
	for(u8 nslv = 0;nslv<NSLV;nslv++) {
		g_u8Adbms6815_CfgrA[eAfe][nslv][0] = (EnPs|REFON|ADCOPT);																			// cfga 1000 0000b
		g_u8Adbms6815_CfgrA[eAfe][nslv][1] = FlagD;
		if(Soak == 1) {
			g_u8Adbms6815_CfgrA[eAfe][nslv][2] = (Soak|Owrn|OWC1|OWC2); 
		}
		g_u8Adbms6815_CfgrA[eAfe][nslv][3] = 0xFF;
		g_u8Adbms6815_CfgrA[eAfe][nslv][3] = (u8)NSTH;
	}
	Adbms6815_Daisy_CfgWrite(eAfe,eComDir,WRCFGA,g_u8Adbms6815_CfgrA);

}

void Adbms6815_WrCfgB(eAdAfe_Type eAfe,eAdComDir_Type eComDir)
{	
	for(u8 nslv = 0;nslv<NSLV;nslv++) {																		// cfgb VOV, VUV default 0xF0
		g_u8Adbms6815_CfgrB[eAfe][nslv][1] = 0x00;
		g_u8Adbms6815_CfgrB[eAfe][nslv][2] = 0x00;
	}
	Adbms6815_Daisy_CfgWrite(eAfe,eComDir,WRCFGB,g_u8Adbms6815_CfgrB);
}


/* CONFIG BAL BEGIN**************************************************************************************************************************/
void Adbms6815_WrCfgBal(eAdAfe_Type eAfe, eAdComDir_Type eComDir,u16 u16ManualbalFlag[], BOOL bManualBal)
{
	u8 	i				= 0;
	u8	nslv			= 0;	// daisy buff size (4+8) * 36
	u8	slvpos[NSLV]	= {0,};

	for(i = 0; i < NSLV; i ++){														
		slvpos[i] = Adbms6815_Get_AfePos(i);																	// read buff position 
	}

	for(nslv = 0U; nslv < NSLV; nslv++){																		// mask bal flag
		g_u8Adbms6815_CfgrB[eAfe][slvpos[nslv]][3] = 0;
		g_u8Adbms6815_CfgrB[eAfe][slvpos[nslv]][3] = g_sAd6815Data.u8CvBal[eAfe][nslv] & 0xff;
	}
	
	Adbms6815_Daisy_CfgWrite(eAfe,eComDir,WRCFGB,g_u8Adbms6815_CfgrB);
}

void Adbms8615_WrcfgBal_EvenOdd(eAdAfe_Type eAfe, eAdComDir_Type eComDir, u8 u8EvenOdd)
{
	u8 u8balbuf[NAFE][NSLV][6]	= {{{0,},},};
	u8 fill = (u8EvenOdd == 1) ? 0xAA : 0x55;
	memset(&u8balbuf, fill, sizeof(u8balbuf));
	Adbms6815_Daisy_CfgWrite(eAfe,eComDir,WRCFGB,u8balbuf);
}


/* CONFIG BAL END****************************************************************************************************************************/
void Adbms6815_Daisy_Read_DmaEnd(eAdAfe_Type eAfe,eAdComDir_Type eComDir, eRegGroup_Type eRegGroup,u16 u16Cv[][NSLV][NSCV], eAdRead_Type eRdType)
{
	u8	nreg 		= 0;
	u8	nslv		= 0;
	u8	stapos		= (eRegGroup * NGRP);
	u8	slvpos[NSLV] = {0,}; 
	u8	reg[NREG]	= {0,};
	u16	pec_rx		= 0;
	u16	pec_mk 		= 0;
	u16	cmdcnt 		= 0;
	//u16	dirpos		= 0;
	float buf[3]	= {0.0f,};

	Adbms6815_ChipSel(eAfe,eComDir, FALSE); 																		// 

	for(nslv=0; nslv<NSLV; nslv++){
		slvpos[nslv] = Adbms6815_Get_AfePos(nslv);																// get afe pos
	}

	for(nslv=0; nslv<NSLV; nslv++){
		pec_rx = ((u16)(g_u8Rx[eAfe][eRegGroup][10+(nslv*8)])<<8)+g_u8Rx[eAfe][eRegGroup][11+(nslv*8)];						// read pec
		cmdcnt = Adbms6815_CmdCnt(&pec_rx);																		// cmdcount
		pec_mk = Adbms6815_DatPec10(&g_u8Rx[eAfe][eRegGroup][4+ nslv*8], 6, TRUE);									// make pec
		
		if(pec_rx == pec_mk){																					// compare pec
			for(nreg=0; nreg<6; nreg++){
				reg[nreg] = g_u8Rx[eAfe][eRegGroup][4+(nslv*8)+nreg];
			}

			 switch (eRdType) {
			    case READ_CV_Type:                                     											// cell 3ea / 123 / 456 / 78
			        u16Cv[eAfe][slvpos[nslv]][stapos + 0] = (u16)(((u16)reg[0]) | ((u16)reg[1] << 8));
			        u16Cv[eAfe][slvpos[nslv]][stapos + 1] = (u16)(((u16)reg[2]) | ((u16)reg[3] << 8));
			        if (stapos < 6) {
			            u16Cv[eAfe][slvpos[nslv]][stapos + 2] = (u16)(((u16)reg[4]) | ((u16)reg[5] << 8));
			        }break;

			    case READ_TH_Type:
			        buf[0] = (float)((float)reg[1] * 256.0f);
			        buf[1] = (float)((float)reg[0] + buf[0]) * 1.1f;

			        if (eRegGroup != Group_A_Type) {
			            g_sAd6815Data.s16Th[eAfe][slvpos[nslv]][stapos + 0U] =(s16)TempAmbient((u16)buf[1]);          // T3 T6
			        } else {
			            g_sAd6815Data.u16Vref2[eAfe][slvpos[nslv]] = (u16)buf[1];                                  	// Vreg2
			        }

			        buf[0] = (float)((float)reg[3] * 256.0f);
			        buf[1] = (float)((float)reg[2] + buf[0]) * 1.1f;
			        g_sAd6815Data.s16Th[eAfe][slvpos[nslv]][stapos + 1U] = (s16)TempAmbient((u16)buf[1]);              // T1 T4 T7

			        buf[0] = (float)((float)reg[5] * 256.0f);
			        buf[1] = (float)((float)reg[4] + buf[0]) * 1.1f;

			        if (eRegGroup != Group_C_Type) {
			            g_sAd6815Data.s16Th[eAfe][slvpos[nslv]][stapos + 2U] = (s16)TempAmbient((u16)buf[1]);
			        } else {
			            g_sAd6815Data.u16Vref3[eAfe][slvpos[nslv]] = (u16)buf[1];                                 	// Vref3
			        }break;

			    case READ_ST_Type:
			        // TODO: status
			        break;

			    default:
			        break;
            }
		}else{
			//TODO : All 0xff status (open line, ic err, noise)
		}
	}
}


//chip select direction
void Adbms6815_Cal_AfePos(eAdComDir_Type eComDir,eAdRw_Type eWriteRead)
{
	u8 i = 0;
	if(eWriteRead == WR_Wr_Type){ 																				// Write
		if(eComDir == ComDir_A_Type){					
			for(i = 0;i<NSLV;i++){
				g_u8AfePos[i] = i;																				// AFE1 -> Write(Near(0) -> Far(35))
			}	
		}else if(eComDir == ComDir_B_Type){			
			for(i = 0;i<NSLV;i++){
				g_u8AfePos[i] = ((NSLV-1)-i); 																	// AFE1 -> Write(Far(35) -> Near(0))
			}
		}
	}else{																										// Read
		if(eComDir == ComDir_A_Type){					
			for(i = 0;i<NSLV;i++){
				g_u8AfePos[i] = ((NSLV-1)-i); 																	// AFE2 -> Read(Near(0) -> Far(35))
			}
		}else if(eComDir == ComDir_B_Type){
			for(i = 0;i<NSLV;i++){
				g_u8AfePos[i] = i;																				// AFE2 -> Read(Far(35) -> Near(0))
			}
		}
	}	
}

u8 Adbms6815_Get_AfePos(u8 u8AfePos)
{
	if(u8AfePos >= NSLV) { u8AfePos = 0; }
	return g_u8AfePos[u8AfePos];
}

void HAL_SPI_TxRxCpltCallback(SPI_HandleTypeDef *hspi)
{
	 if(g_sAd6815Data.bDmaReadDone == FALSE){
		g_sAd6815Data.bDmaReadDone = TRUE;
	}
}



void Adbms6815_ManualBalance(eAdComDir_Type eComDir)
{
#if 0
	u32 i = 0;

	if(   ((pstCanReq->u8ManualTestCmdPos >> ManualTestCmd_Balancing_Type) & 0x01) == TRUE ){
		// Cell Balancing
		if(   ((pstCanReq->u8ManualTestCmdValue >> ManualTestCmd_Balancing_Type) & 0x01) == TRUE  ){
			for(i = 0; i < g_stBmsStatus.u8MonIcCount; i ++){
				g_sAd6815Data.u16fBal[i] = 0xFFFF;
			}
		}else{
			for(i = 0; i < g_stBmsStatus.u8MonIcCount; i ++){
				g_sAd6815Data.u16fBal[i] = 0;
			}
		}
	}
#endif
}

u16 Adbms6815_CmdCnt(u16* pu16ReadPec)
{
	u16 u16CmdCounter = 0;
	u16 u16Temp = 0;

	u16CmdCounter = (*pu16ReadPec >>10) & 0x3F;
	u16Temp = (*pu16ReadPec) & 0x3FF;

	(*pu16ReadPec) = u16Temp;
	return u16CmdCounter;
}


void Adbms6815_Init(void)
{		
	//HAL_DMA_RegisterCallback(&hspi1, HAL_DMA_XFER_CPLT_CB_ID, Adbms6815_Callback_DMAReComplete());			//HAL_DMA_XFER_CPLT_CB_ID  DMA Send Check Index
	g_sAd6815Data.eAfe = AFE1_Type;
	g_sAd6815Data.eComDir = ComDir_A_Type;

	Adbms6815_Init_Pec15_Table();
	Adbms6815_Init_Pec10_Table();
	g_sAd6815Data.bAdbmsInitDone = TRUE; 
}

void Adbms6815_Proc(void)
{
	sAdbms6815 *pAd	= &g_sAd6815Data;
	static u8 s_eAdcType = 0;
	static u16 s_u16cnt		= 0;
	eRegGroup_Type grp		= 0;
	eAdComDir_Type eComDir	= pAd->eComDir;
	
	u8 k					= 0;
	u8 i					= 0;
	
	if(s_u16cnt == 0){
		for(i=0;i<2;i++) {Adbms6815_Cmd_Write(i,eComDir,SRST);}																			// afe reset
		for(i=0;i<2;i++) {Adbms6815_Cmd_Write(i,eComDir,CLRCELL);}																		// 1. clear reg
		for(i=0;i<2;i++) {Adbms6815_WrCfgA(i,eComDir,0,0,0,0);}																			// cfg a
		for(i=0;i<2;i++) {Adbms6815_WrCfgB(i,eComDir);}																					// cfg b
		for(i=0;i<2;i++) {Adbms6815_Cmd_Write(i,eComDir,ADCV);}
	}else if(s_u16cnt ==5){	
		for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCVA); }
	}else if(s_u16cnt ==15){ 
		for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCVB);}
		for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,Group_A_Type, pAd->u16Cv,READ_CV_Type);}
	}else if(s_u16cnt ==25){ 
		for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCVC);}
		for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,Group_B_Type, pAd->u16Cv,READ_CV_Type);}
	}else if(s_u16cnt ==35){
		for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,Group_C_Type, pAd->u16Cv,READ_CV_Type);}
		for(i=0;i<2;i++) { Adbms6815_Cmd_Write(i,eComDir,CLRCELL); }																	// clear reg
		switch(s_eAdcType){
			case ADC_EV_Type:
				for(i=0;i<2;i++) { Adbms6815_WrCfgA(i,eComDir,0,0,1,1);}																// cfg a
				for(i=0;i<2;i++) { Adbms8615_WrcfgBal_EvenOdd(i,eComDir,EVEN);}															// cfg b (bal start) even
				break;
			case ADC_OD_Type:
				for(i=0;i<2;i++) { Adbms6815_WrCfgA(i,eComDir,0,0,1,1);}																// cfg a
				for(i=0;i<2;i++) { Adbms8615_WrcfgBal_EvenOdd(i,eComDir,ODD);}															// cfg b (bal start) odd
				break;
			case ADC_SV_Type:
				break;
			case ADC_OW_Type:
				break;
			case ADC_CH1_Type:
				for(i=0;i<2;i++) { Adbms6815_WrCfgA(i,eComDir,PSL,FLAGD5,0,0);}															// sm 41
				break;
			case ADC_CH2_Type:
				for(i=0;i<2;i++) { Adbms6815_WrCfgA(i,eComDir,PSH,FLAGD5,0,0);}															// sm 41
				break;
			default:
				break;
		}
		for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,Group_B_Type, pAd->u16Cv,READ_CV_Type);}
	}else if(s_u16cnt == 45){
		switch(s_eAdcType){
			case ADC_EV_Type:	for(i=0;i<2;i++) { Adbms6815_Cmd_Write(i,eComDir,ADCV);}									break;		// cv evn start conv	
			case ADC_OD_Type:	for(i=0;i<2;i++) { Adbms6815_Cmd_Write(i,eComDir,ADCV);}									break;		// cv odd start conv
			case ADC_SV_Type:
				for(i=0;i<2;i++) { 
					for(k=0;k<6;k++){
						Adbms6815_Cmd_Write(i,eComDir,ADSC|DC|(k+1));										// sv start conv 480us *6	
						Delay_us(500);
					}
				}break;
			case ADC_OW_Type:	for(i=0;i<2;i++) { Adbms6815_Cmd_Write(i,eComDir,CVOW);}									break;		// ow start conv	
			case ADC_CH1_Type:	for(i=0;i<2;i++) { Adbms6815_Cmd_Write(i,eComDir,ADCV); }									break;		// cv adc1 start conv	
			case ADC_CH2_Type:	for(i=0;i<2;i++) { Adbms6815_Cmd_Write(i,eComDir,ADCV);}									break;		// cv adc2 start conv
		}
	}else if(s_u16cnt == 55){
		grp = Group_A_Type;
		switch(s_eAdcType){
			case ADC_EV_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCVA);}						break;		// cv evn read sta	A conv	
			case ADC_OD_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCVA);}						break;		// cv odd read sta 	A conv	
			case ADC_SV_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCDA);}						break;		// sv read sta		A conv	
			case ADC_OW_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCDA);}						break;		// ow read sta		A conv	
			case ADC_CH1_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCVA);}						break;		// cv adc1 read sta	A conv	
			case ADC_CH2_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCVA);}						break;		// cv adc2 read sta	A conv
		}
	}else if(s_u16cnt == 65){
		grp = Group_B_Type;
		switch(s_eAdcType){
			case ADC_EV_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCVB);}						break;		// cv evn read sta	B conv
			case ADC_OD_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCVB);}						break;		// cv odd read sta 	B conv
			case ADC_SV_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCDB);}						break;		// sv read sta		B conv		
			case ADC_OW_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCDB);}						break;		// ow read sta		B conv
			case ADC_CH1_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCVB);}						break;		// cv adc1 read sta	B conv	
			case ADC_CH2_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCVB);}						break;		// cv adc2 read sta	B conv
		}
		grp = Group_A_Type;
		switch(s_eAdcType){
			case ADC_EV_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16EvCv,READ_CV_Type); } 	break;		// cv evn read end	A cast
			case ADC_OD_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16OdCv,READ_CV_Type);}   break;		// cv odd read end 	A cast
			case ADC_SV_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16Sv,READ_CV_Type);}		break;		// sv read end		A cast		
			case ADC_OW_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16Ow,READ_CV_Type);}	  	break;		// ow read end		A cast		
			case ADC_CH1_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16Ad1Cv,READ_CV_Type); }	break;		// cv adc1 read end	A cast		
			case ADC_CH2_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16Ad2Cv,READ_CV_Type); }	break;		// cv adc2 read end	A cast		
		}
	}else if(s_u16cnt == 75){
		grp = Group_C_Type;
		switch(s_eAdcType){
			case ADC_EV_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCVC);}						break;		// cv evn read sta	C conv
			case ADC_OD_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCVC);}						break;		// cv odd read sta 	C conv
			case ADC_SV_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCDC);}						break;		// sv read sta		C conv
			case ADC_OW_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCDC);}						break;		// ow read sta		C conv
			case ADC_CH1_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCVC);}						break;		// cv adc1 read sta	C conv
			case ADC_CH2_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,grp,RDCVC);}						break;		// cv adc2 read sta	C conv
		}
		grp = Group_B_Type;
		switch(s_eAdcType){
			case ADC_EV_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16EvCv,READ_CV_Type);}	break;		// cv evn read end	B cast
			case ADC_OD_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16OdCv,READ_CV_Type);}	break;		// cv odd read end 	B cast
			case ADC_SV_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16Sv,READ_CV_Type);}		break;		// sv read end		B cast	
			case ADC_OW_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16Ow,READ_CV_Type);}		break;		// ow read end		B cast	
			case ADC_CH1_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16Ad1Cv,READ_CV_Type);}	break;		// cv adc1 read end	B cast
			case ADC_CH2_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16Ad2Cv,READ_CV_Type);}	break;		// cv adc2 read end	B cast
		}
	}else if(s_u16cnt == 85){
		grp = Group_C_Type;
		Adbms6815_Cmd_Write(i,eComDir,ADAX);																							// th start conversion
		switch(s_eAdcType){
			case ADC_EV_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16EvCv,READ_CV_Type);}	break;		// cv evn read end	C cast
			case ADC_OD_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16OdCv,READ_CV_Type);}	break;		// cv odd read end 	C cast
			case ADC_SV_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16Sv,READ_CV_Type);}		break;		// sv read end		C cast		
			case ADC_OW_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16Ow,READ_CV_Type);}		break;		// ow read end		C cast		
			case ADC_CH1_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16Ad1Cv,READ_CV_Type);}	break;		// cv adc1 read end	C cast		
			case ADC_CH2_Type:	for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,grp,pAd->u16Ad2Cv,READ_CV_Type);}	break;		// cv adc2 read end	C cast		
		}
		for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,Group_A_Type,RDAXA);}												// th read sta		A conv
	}else if(s_u16cnt == 50){
		for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,Group_B_Type,RDAXB);}												// th read sta		B conv
		for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,Group_A_Type,pAd->u16Cv,READ_TH_Type);}								// th read end		A cast
	}else if(s_u16cnt == 60){
		for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaStart(i,eComDir,Group_C_Type,RDAXC);}												// th read sta		C conv
		for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,Group_B_Type,pAd->u16Cv,READ_TH_Type);}								// th read end		B cast
	}else if(s_u16cnt == 70){
		for(i=0;i<2;i++) { Adbms6815_Daisy_Read_DmaEnd(i,eComDir,Group_C_Type,pAd->u16Cv,READ_TH_Type);}								// th read end		C cast
	}else if(s_u16cnt == 80){
		//TODO : loop BMS data 
		// meas : curr, pv, pn
		// cal cv, th, curr
		// cal soc, soh
		// bms status
		// uart tx
		// mvb tx
		// check det
		// relay contol
		// btms rs485 comm	
		// ext
	}else if(s_u16cnt == 100){
		// SM Diagnosit Start
		
	}else if(s_u16cnt == 150){
		
	}

	if(++s_u16cnt > 200){
		s_u16cnt = 0;
		if(++s_eAdcType> (u8)MAX_AdcConv_Type){
			s_eAdcType = 0;
		}
	}
}


