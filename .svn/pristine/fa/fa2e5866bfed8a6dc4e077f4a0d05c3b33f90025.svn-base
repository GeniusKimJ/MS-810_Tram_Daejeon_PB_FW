u16 Adbms6815_CmdPec15(u8 *data , int len)
{
	u16 remainder	= 0;
	u16 address 	= 0;
	u16 i 			= 0;
	
	remainder = 16;//PEC seed

	for (i = 0; i < len; i++){
		address = ((remainder >> 7) ^ data[i]) & 0xff;//calculate PEC table address
		remainder = (remainder << 8 ) ^ g_u16Adbms6815_Pec15Table[address];
	}
	return (remainder*2);//The CRC15 has a 0 in the LSB so the final value must be multiplied by 2
}

//data sheet lib
u16 Adbms6815_DatPec10(u8 *data, int len, BOOL bIsRxCmd)
{
	u8	nbyteIndex	= 0;
	//u8	bitIndex	= 0;
	u16	nremainder 	= 16u;/* PEC_SEED */
	u16	npolynomial	= 0x8Fu;/* x10 + x7 + x3 + x2 + x + 1 <- the CRC10 polynomial 100 1000 1111 */
	u16	ntableaddr	= 0;
	
	 for (nbyteIndex = 0u; nbyteIndex < len; ++nbyteIndex) {
		 /* calculate PEC table address */
		 ntableaddr = (u16)((u16)(nremainder >> 2) ^ (u8)data[nbyteIndex]) & (u8)0xff;
		 nremainder = ((u16)(nremainder << 8)) ^ g_u16Adbms6815_Pec10Table[ntableaddr];
	 }

	 if (bIsRxCmd == TRUE){ /* If array is from received buffer add command counter to crc calculation */
		 nremainder ^= (u16)(((u16)data[len] & (u8)0xFC) << 2u);
	 }

	/* Perform modulo-2 division, a bit at a time on rest of the bits */
	for (nbyteIndex = 6u; nbyteIndex > 0u; --nbyteIndex){
		/* Try to divide the current data bit */
		if ((nremainder & 0x200u) > 0u){
			nremainder = (u16)((nremainder << 1u));
			nremainder = (u16)(nremainder ^ npolynomial);
		}else{
			nremainder = (u16)((nremainder << 1u));
		}
	}
		return ((u16)(nremainder & 0x3FFu));
}



//FuSa SM8 : Command CRC
void Adbms6815_Init_Pec15_Table(void)
{
	u16 remainder = 0, i = 0, bit = 0;
	for (i = 0; i < 256; i++){
		remainder = i << 7;
		for (bit = 8; bit > 0; --bit){
			if (remainder & 0x4000){ 
				remainder = ((remainder << 1));   
				remainder = (remainder ^ g_u16Adbms6815_Crc15_Poly); 
			}else{ 
				remainder = ((remainder << 1)); 
			}
		}g_u16Adbms6815_Pec15Table[i] = remainder&0xFFFF;
	}
}


void Adbms6815_Init_Pec10_Table(void)
{
	u16 remainder = 0, i = 0, bit = 0;
	for (i = 0; i < 256; i++){
		remainder = i << 2;
		for (bit = 8; bit > 0; --bit){
			if (remainder & 0x200) { 
				remainder = ((remainder << 1));   
				remainder = (remainder ^ g_u16Adbms6815_Crc10_Poly); 
			}else{
				remainder = ((remainder << 1)); 
			}
		}g_u16Adbms6815_Pec10Table[i] = remainder & 0x3FF;
	}
}

void Adbms6815_ChipSel(eAdAfe_Type eAfe, BOOL bComDir, BOOL bSelect)
{
    GPIO_TypeDef *gpio = NULL;
    GPIO_PinState pinState = GPIO_PIN_RESET;
    u16 u16Pin = 0U;

    if (eAfe == AFE1_Type){
        gpio = GPIOE;
        u16Pin = (bComDir == 0U) ? GPIO_PIN_0 : GPIO_PIN_1;
    }else{
        gpio = GPIOC;
        u16Pin = (bComDir == 0U) ? GPIO_PIN_14 : GPIO_PIN_15;
    }

    pinState = (bSelect == TRUE) ? GPIO_PIN_RESET : GPIO_PIN_SET;

    HAL_GPIO_WritePin(gpio, u16Pin, pinState);
}

void Adbms6815_Wakeup(eAdAfe_Type eAfe, eAdComDir_Type eComDir)
{
	u32	dlywk 	= 2;																							// 1us
	u32	rty		= 3;
	
	for(u32 i = 0;i < rty; i ++){
		Adbms6815_ChipSel(eAfe,eComDir, TRUE); 
		Delay_us(dlywk);
		Adbms6815_ChipSel(eAfe,eComDir, FALSE); 
		Delay_us(dlywk);
	}
}

void Adbms6815_Cmd_Write(eAdAfe_Type eAfe, eAdComDir_Type eComDir,u16 u16Cmd)
{
	SPI_HandleTypeDef *hspi = (eAfe == AFE1_Type) ? &hspi1 : &hspi2;
	u8	tx[4+8]	= {0,}; 
	u16	pec		= 0;

	tx[0] = (u8)(u16Cmd >> 8) & 0xFF;
	tx[1] = (u8)(u16Cmd & 0xFF);

	pec = Adbms6815_CmdPec15(&tx[0], 2);
	tx[2] = (u8)((pec >> 8) & 0xFF);
	tx[3] = (u8)(pec & 0xFF);
	
	Adbms6815_ChipSel(eAfe,eComDir, TRUE);
	Delay_us(2);
	HAL_SPI_Transmit(hspi,tx, sizeof(tx),5);																					//�۽� ���?���� Ȯ�� ������ TX�Լ��� ȣ��
	Delay_us(2);	
	Adbms6815_ChipSel(eAfe,eComDir, FALSE);
}

